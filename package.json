  },
  "keywords": ["blender", "cli", "bpy", "agent", "llm", "headless", "automation", "3d", "animation"],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0"
  }
}
