{
  "name": "blender-cli",
  "version": "0.0.1",
  "description": "Drive Blender headless from your agent: scaffold, build, animate from natural language. JSON in, JSON out.",
  "type": "module",
  "bin": {
    "blender-cli": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
