// `blender-cli exec "<bpy>"` | `blender-cli run <script.py>` — agent-authored bpy.
// The agent writes bpy; set keys on `result` and they come back as JSON.
// --check compiles the code and flags risky calls WITHOUT executing anything
// (ok:false + exit 1 when the code does not compile — same contract as everywhere).
// --safe refuses to run code that trips the AST gate (BLENDER_CLI_SAFE=1 makes
// it the default; --unsafe overrides). --timeout <sec> kills a hung Blender.
const EXEC_FLAGS = ['blend', 'save', ...COMMON_FLAGS];
const EXEC_USAGE = 'blender-cli exec "<bpy code>" [--blend f.blend] [--save out.blend] [--check] [--safe] [--detach] [--addons a,b] [--timeout sec]';
async function execBody(body, args, ctx) {
  const { flags } = fdn.parseArgs(args, EXEC_FLAGS);
  const safeMode = flags.unsafe ? false
    : flags.safe ? true
    : (env.BLENDER_CLI_SAFE ?? process.env.BLENDER_CLI_SAFE) === '1';
  if (flags.check) {
    const checker = `import re
code = PARAMS["__code__"]
try:
    compile(code, "<agent-bpy>", "exec")
    result["compiles"] = True
except SyntaxError as e:
    result["compiles"] = False
    result["syntax_error"] = {"line": e.lineno, "msg": e.msg, "text": (e.text or "").strip()}
RISKY = [
    (r"\\bos\\.system", "os.system", "shell command"),
    (r"\\bsubprocess\\b", "subprocess", "subprocess spawn"),
    (r"\\bshutil\\.rmtree", "shutil.rmtree", "recursive delete"),
    (r"\\bos\\.(remove|unlink|rmdir)\\b", "os.remove/unlink/rmdir", "file delete"),
    (r"\\beval\\s*\\(", "eval()", "dynamic eval"),
    (r"\\bexec\\s*\\(", "exec()", "dynamic exec"),
    (r"\\b__import__\\b", "__import__", "dynamic import"),
    (r"^\\s*(import|from)\\s+socket\\b|\\bsocket\\.socket\\b", "socket", "network access"),
    (r"^\\s*(import|from)\\s+urllib\\b|\\burllib\\.request\\b", "urllib", "network access"),
    (r"^\\s*(import|from)\\s+requests\\b|\\brequests\\.(get|post|put|delete)\\b", "requests", "network access"),
    (r"\\bhttp\\.client\\b", "http.client", "network access"),
    (r"\\bsys\\.exit\\b", "sys.exit", "interpreter exit"),
]
result["warnings"] = [{"call": name, "risk": why} for pat, name, why in RISKY if re.search(pat, code, re.M)]
result["bpy_version"] = list(bpy.app.version)
result["checked_only"] = True`;
    const r = runBlender(checker, { params: { __code__: body }, flags });
    if (r.ok && r.result && r.result.compiles === false) { r.ok = false; r.error = 'agent code does not compile'; }
    // Version-aware API drift: only the rows that apply to THIS build are reported.
    if (r.result) r.result.api_drift = driftFor(body, r.result.bpy_version || null);
    if (r.ok && safeMode) {
      const g = runBlender(SAFE_EXEC_BODY, { params: { __code__: body, __validate_only__: true }, flags });
      if (g.ok) r.result.safe_gate = g.result?.safe_gate || 'pass';
      else { r.ok = false; r.error = g.error; if (g.result?.violations) r.result.violations = g.result.violations; }
    }
    show(r, ctx); if (!r.ok) process.exit(1);
    return;
  }
  if (flags.detach) {
    const r = safeMode
      ? runBlenderDetached(SAFE_EXEC_BODY, { blend: flags.blend, save: flags.save, params: { __code__: body }, flags }, { command: 'exec' })
      : runBlenderDetached(body, { blend: flags.blend, save: flags.save, flags }, { command: 'exec' });
    show(r, ctx); if (!r.ok) process.exit(1);
    return;
  }
  const r = safeMode
    ? runBlender(SAFE_EXEC_BODY, { blend: flags.blend, save: flags.save, params: { __code__: body }, flags })
    : runBlender(body, { blend: flags.blend, save: flags.save, flags });
  // A failure on a known API move gets the matching hint appended, so the agent
  // learns the replacement from the error instead of from a second search.
  if (!r.ok && Array.isArray(r.bpy_version)) {
    const drift = driftFor(body, r.bpy_version);
    if (drift.length) r.api_drift = drift;
  }
  show(r, ctx); if (!r.ok) process.exit(1);
}
commands.exec = async (args, ctx) => {
