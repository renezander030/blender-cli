        if (receipt) r.receipt = receipt;
        return r;
      }, batchOptions(flags, 'render', { ...params, out: outDir, animation, ext }));
    } catch (e) { agg = { ok: false, error: e.message }; }
    show(agg, ctx); if (!agg.ok) process.exit(1);
    return;
  }
  const r = runBlender(body, { blend: flags.blend, params, flags });
  show(r, ctx); if (!r.ok) process.exit(1);
};

// `blender-cli import <file | polyhaven:id>` — pull an asset into the scene:
// a local file (glTF/GLB, OBJ, FBX, STL, PLY, USD, Alembic, Collada) or a Poly
// Haven asset by id (model -> imported, hdri -> world environment, texture ->
// wired PBR material). Reports what arrived so the agent can verify.
commands.import = async (args, ctx) => {
  const { flags, positional } = fdn.parseArgs(args, ['blend', 'save', 'type', 'res', 'maps', 'batch', ...COMMON_FLAGS]);
  const src = positional[0];
  if (flags.batch) {
    const files = globFiles(String(flags.batch));
    if (!files.length) {
      show({ ok: false, error: `--batch matched no files: ${flags.batch}`, hint: 'quote the pattern so the shell does not expand it first; * and ? are supported in the last path segment, ** is not' }, ctx);
      process.exit(1);
    }
    const r = runBlender(MULTI_IMPORT_BODY, { blend: flags.blend, save: flags.save, params: { files }, flags });
    if (r.ok && r.result?.imported_batch?.failed > 0) {
      r.ok = false;
      r.error = `${r.result.imported_batch.failed} of ${r.result.imported_batch.total} file(s) failed to import`;
    }
    show(r, ctx); if (!r.ok) process.exit(1);
    return;
  }
  if (src && src.startsWith('polyhaven:')) {
    const assetId = src.slice('polyhaven:'.length);
    const res = flags.res || '1k';
    let dl;
    const maps = typeof flags.maps === 'string' ? flags.maps.split(',').map(x => x.trim()).filter(Boolean) : null;
    if (flags.maps === true || (flags.maps !== undefined && !maps?.length)) {
      show({ ok: false, error: 'missing value for --maps (comma-separated map names)' }, ctx); process.exit(1);
    }
    try { dl = await polyhavenDownload(assetId, { type: flags.type, res, maps }); }
    catch (e) {
      show({ ok: false, error: e.message, hint: 'check the asset id on https://polyhaven.com, --type hdri|texture|model, --res 1k|2k|4k' }, ctx);
      process.exit(1);
    }
    const r = dl.kind === 'hdri' ? runBlender(HDRI_IMPORT_BODY, { blend: flags.blend, save: flags.save, params: { path: dl.main, pack: !!flags.pack }, flags })
      : dl.kind === 'model' ? runBlender(IMPORT_BODY, { blend: flags.blend, save: flags.save, params: { file: dl.main, pack: !!flags.pack }, flags })
      : runBlender(TEXTURE_IMPORT_BODY, { blend: flags.blend, save: flags.save, params: { maps: dl.maps, material_name: assetId, pack: !!flags.pack }, flags });
    if (r.ok) r.result = { ...(r.result || {}), asset_id: assetId, asset_type: dl.kind, resolution: res,
      files: dl.files.length, cached: dl.cached, cache_dir: dl.cache_dir, provenance: dl.provenance,
      selected_maps: maps, packed: !!flags.pack };
    show(r, ctx); if (!r.ok) process.exit(1);
    return;
  }
  if (!src || !existsSync(src)) {
    show({ ok: false, error: `asset file not found: ${src || '(none given)'}`, usage: 'blender-cli import <asset-file | polyhaven:id> [--blend f] [--save f] [--type hdri|texture|model] [--res 1k|2k|4k]' }, ctx);
    process.exit(1);
  }
  const localExt = src.toLowerCase().split('.').pop();
  const r = (flags.type === 'hdri' || ['hdr', 'exr'].includes(localExt))
    ? runBlender(HDRI_IMPORT_BODY, { blend: flags.blend, save: flags.save, params: { path: resolve(src), pack: !!flags.pack }, flags })
    : runBlender(IMPORT_BODY, { blend: flags.blend, save: flags.save, params: { file: resolve(src), pack: !!flags.pack }, flags });
  show(r, ctx); if (!r.ok) process.exit(1);
};

// `blender-cli generate "<prompt>"` — text-to-3D via Meshy (MESHY_API_KEY),
// or `--image <file>` for image-to-3D off a reference photo. Downloads the GLB
// and optionally chains straight into the scene with --import. Both modes share
// one polling/download/import path; only the endpoint and payload differ.
const IMAGE_MIME = { png: 'image/png', jpg: 'image/jpeg', jpeg: 'image/jpeg', webp: 'image/webp' };
commands.generate = async (args, ctx) => {
  const { flags, positional } = fdn.parseArgs(args, ['out', 'backend', 'blend', 'save', 'wait', 'image', ...COMMON_FLAGS]);
  const prompt = positional.join(' ').trim();
  const usage = 'blender-cli generate "<prompt>" | generate --image ref.png [--out asset.glb] [--import] [--blend f] [--save f] [--wait sec]';
  const imageArg = typeof flags.image === 'string' ? flags.image : null;
  if (flags.image === true) { show({ ok: false, error: 'missing value for --image', usage }, ctx); process.exit(1); }
  if (!prompt && !imageArg) { show({ ok: false, error: 'missing prompt (or --image <file>)', usage }, ctx); process.exit(1); }
  const backend = flags.backend || 'meshy';
  if (backend !== 'meshy') { show({ ok: false, error: `unknown backend: ${backend}`, hint: 'available: meshy' }, ctx); process.exit(1); }
  let imagePath = null, imageMime = null;
  if (imageArg) {
    imagePath = resolve(imageArg);
    if (!existsSync(imagePath)) { show({ ok: false, error: `image not found: ${imageArg}` }, ctx); process.exit(1); }
    imageMime = IMAGE_MIME[imagePath.toLowerCase().split('.').pop()];
    if (!imageMime) { show({ ok: false, error: `unsupported image format: ${imagePath.split('.').pop()}`, hint: `use one of: ${Object.keys(IMAGE_MIME).join(', ')}` }, ctx); process.exit(1); }
  }
  const apiKey = env.MESHY_API_KEY || process.env.MESHY_API_KEY;
  if (!apiKey) { show({ ok: false, error: 'MESHY_API_KEY not set', hint: 'export MESHY_API_KEY=<key from https://www.meshy.ai> and retry' }, ctx); process.exit(1); }
  const waitSec = flags.wait !== undefined ? Number(flags.wait) : 300;
  if (!Number.isFinite(waitSec) || waitSec <= 0) { show({ ok: false, error: `invalid --wait: ${flags.wait} (whole seconds)` }, ctx); process.exit(1); }
  const stem = imagePath ? basename(imagePath).replace(/\.[^.]+$/, '') : prompt.replace(/\W+/g, '_').slice(0, 40);
  const out = resolve(flags.out || `${stem || 'generated'}.glb`);
  const base = env.MESHY_API_BASE || process.env.MESHY_API_BASE || 'https://api.meshy.ai';
  const H = { 'Authorization': `Bearer ${apiKey}` };
  const t0 = Date.now();
  let taskId = null;
  // Meshy keeps image-to-3d on v1 and text-to-3d on v2; the task shape that
  // comes back (status + model_urls) is the same, so only submission differs.
  const endpoint = imagePath ? `${base}/openapi/v1/image-to-3d` : `${base}/openapi/v2/text-to-3d`;
  const payload = imagePath
    ? { image_url: `data:${imageMime};base64,${readFileSync(imagePath).toString('base64')}`, enable_pbr: true, should_remesh: true, ...(prompt ? { texture_prompt: prompt } : {}) }
    : { mode: 'preview', prompt, art_style: 'realistic', should_remesh: true };
  try {
    const sub = await fetch(endpoint, {
      method: 'POST', headers: { ...H, 'Content-Type': 'application/json' },
      body: JSON.stringify(payload),
    });
    if (!sub.ok) throw new Error(`meshy submit failed: HTTP ${sub.status}: ${(await sub.text()).slice(0, 300)}`);
    taskId = (await sub.json()).result;
    const deadline = Date.now() + waitSec * 1000;
    let task = null, failures = 0;
    while (true) {
      try {
        const p = await fetch(`${endpoint}/${taskId}`, { headers: H });
        if (!p.ok) throw new Error(`HTTP ${p.status}`);
        task = await p.json(); failures = 0;
      } catch (e) {
        failures++;
        if (failures >= 3) throw new Error(`meshy poll failed 3 times in a row (${e.message}); task ${taskId} may still complete on meshy.ai`);
      }
      if (task && ['SUCCEEDED', 'FAILED', 'CANCELED'].includes(task.status)) break;
      const remaining = deadline - Date.now();
      if (remaining <= 0) break;
      await new Promise(rs => setTimeout(rs, Math.min(5000, remaining)));
    }
    if (task?.status !== 'SUCCEEDED') {
      const extra = task?.task_error?.message ? ` - ${task.task_error.message}` : '';
      throw new Error(`meshy task did not succeed: ${task?.status ?? 'no response'}${extra}`);
    }
    if (!task.model_urls?.glb) throw new Error('meshy task succeeded but no glb url in response');
    await downloadTo(task.model_urls.glb, out, null, { force: true });
    const meta = { generated: out, backend, mode: imagePath ? 'image-to-3d' : 'text-to-3d', task_id: taskId, status: task.status, bytes: statSync(out).size, ...(imagePath ? { source_image: imagePath } : {}) };
    if (flags.import) {
      const r = runBlender(IMPORT_BODY, { blend: flags.blend, save: flags.save, params: { file: out }, flags });
      r.result = { ...(r.result || {}), ...meta };
      show(r, ctx); if (!r.ok) process.exit(1);
      return;
    }
    show({ ok: true, result: meta, ms: Date.now() - t0 }, ctx);
  } catch (e) {
    show({ ok: false, error: e.message, ...(taskId ? { task_id: taskId } : {}) }, ctx);
    process.exit(1);
  }
};

// `blender-cli export <out>` — hand the scene to the next tool in the pipeline:
// glTF/GLB, OBJ, FBX, STL, PLY, USD. Format from the extension.
//
// Bytes-on-disk is not fidelity. Exporters drop vertex-colour layers, shape-key
// ranges and whole object types silently, and a corrupt asset then travels down
// the pipeline looking like a success. So after writing, the file is read BACK
// into an empty scene and censused against what went in — compared only on the
// dimensions the target format actually carries, so STL is never accused of
// losing materials it was never able to hold. --no-verify skips the readback,
// --strict turns a degraded result into a non-zero exit.
const EXPORT_BODY = `${FCURVES_HELPER}${SOURCE_DEPENDENCIES}import hashlib as _hashlib
p = PARAMS["out"]; ext = p.lower().rsplit(".", 1)[-1]
sel = bool(PARAMS.get("selected"))
anim = PARAMS.get("animations") is not False
os.makedirs(os.path.dirname(p) or ".", exist_ok=True)
wm = dir(bpy.ops.wm)

def _geometry_payloads(objs):
    deps = bpy.context.evaluated_depsgraph_get()
    geometry = []
    def inspect(evaluated, name):
        if evaluated.type not in ("MESH", "CURVE", "SURFACE", "FONT", "META"): return
        mesh = evaluated.to_mesh()
        try:
            if mesh and len(mesh.vertices):
                geometry.append({"name": name, "type": evaluated.type, "vertices": len(mesh.vertices), "faces": len(mesh.polygons)})
        finally: evaluated.to_mesh_clear()
    for o in objs: inspect(o.evaluated_get(deps), o.name)
    names = set(o.name for o in objs)
    for instance in deps.object_instances:
        if instance.is_instance and (not sel or instance.parent and instance.parent.original.name in names):
            inspect(instance.object, instance.object.name + "@instance")
    return geometry

def _census(objs):
    geometry = _geometry_payloads(objs)
    meshes = [o for o in objs if o.type == "MESH" and o.data]
    mats = set()
    for o in meshes:
        for m in o.data.materials:
            if m: mats.add(m.name)
    def _nsk(o):
        sk = getattr(o.data, "shape_keys", None)
        return max(0, len(sk.key_blocks) - 1) if sk else 0
    # An object counts as animated with two or more keys: a single key holds no
    # motion and several exporters legitimately skip it.
    def _nkeys(o): return sum(len(fc.keyframe_points) for fc in _fcurves(o))
    animated = [o for o in objs if _nkeys(o) >= 2]
    color_channels = []
    color_nonconstant = 0
    for o in meshes:
        for a in (getattr(o.data, "color_attributes", []) or []):
            components = []
            for d in list(a.data)[:4096]:
                v = getattr(d, "color", getattr(d, "vector", getattr(d, "value", None)))
                if v is None: continue
                values = [float(x) for x in v] if hasattr(v, "__len__") else [float(v)]
                while len(components) < len(values): components.append([])
                for i, value in enumerate(values): components[i].append(value)
            ranges = [(max(values) - min(values)) if values else 0.0 for values in components]
            span = max(ranges, default=0.0)
            color_channels.append({"mesh": o.name, "name": a.name, "domain": a.domain, "data_type": a.data_type,
                "samples": len(a.data), "range": round(span, 7), "component_ranges": [round(x, 7) for x in ranges]})
            if span > 1e-6: color_nonconstant += 1
    return {"objects": len(objs), "meshes": len(meshes),
        "geometry_payloads": len(geometry), "evaluated_geometry": geometry,
        "evaluated_verts": sum(g["vertices"] for g in geometry),
        "verts": sum(len(o.data.vertices) for o in meshes),
        "faces": sum(len(o.data.polygons) for o in meshes),
        "loops": sum(len(o.data.loops) for o in meshes),
        "materials": len(mats),
        "material_slots": sum(len(o.data.materials) for o in meshes),
        "uv_layers": sum(len(o.data.uv_layers) for o in meshes),
        "color_attrs": sum(len(getattr(o.data, "color_attributes", []) or []) for o in meshes),
        "color_nonconstant": color_nonconstant, "color_channels": color_channels,
        "shape_keys": sum(_nsk(o) for o in meshes),
        "animated": len(animated), "keyframes": sum(_nkeys(o) for o in animated)}

# What each container can actually represent. Comparing outside this set would
# manufacture "losses" the format was never capable of carrying.
#
# Note the absence of a raw object count: exporters legitimately drop scene
# furniture (glTF omits cameras and lights unless you ask for them), so counting
# objects flags a "loss" on nearly every healthy export. "meshes" is the count
# that speaks to asset payload, and a mesh that actually vanished still shows up
# there. A check that cries wolf on every run is a check people learn to ignore.
# STL and PLY are single triangle-soup containers: they collapse every object
# into one mesh by definition, so comparing mesh COUNT there would report a loss
# on every multi-object export forever. Their vertex total still tells the truth.
# (Each row below was measured against real round-trips, not assumed.)
# Animation is compared as "animated objects", never as raw keyframe counts:
# importers resample (glTF bakes one key per frame), so counts only go UP on a
# healthy round-trip while a vanished animation still shows as 1 -> 0. USD is
# written with animation, but Blender's USD importer does not read it back as
# keyframes, so USD is not judged on it (measured, not assumed).
_ALL = ["geometry_payloads", "meshes", "verts", "faces", "loops", "materials", "material_slots", "uv_layers", "color_attrs", "color_nonconstant", "shape_keys", "animated"]
_GEO_MAT = ["geometry_payloads", "meshes", "verts", "faces", "loops", "materials", "material_slots", "uv_layers"]
CARRIES = {"glb": _ALL, "gltf": _ALL,
    "obj": _GEO_MAT,
    "fbx": ["geometry_payloads", "meshes", "verts", "faces", "loops", "materials", "material_slots", "uv_layers", "shape_keys", "animated"],
    "stl": ["verts", "faces"],
    "ply": ["verts", "faces", "color_attrs", "color_nonconstant"],
    "usd": _GEO_MAT, "usda": _GEO_MAT, "usdc": _GEO_MAT, "usdz": _GEO_MAT}

_scene_objs = [o for o in bpy.context.scene.objects if not sel or o.select_get()]
before = _census(_scene_objs)

def _export(op, defaults):
    props = op.get_rna_type().properties
    options = PARAMS.get("options") or {}
    reserved = {"filepath", "directory", "files", "check_existing", "export_format", "use_selection",
                "export_selected_objects", "selected_objects_only", "export_animations", "bake_anim", "export_animation"}
    validated = {}
    for key, value in options.items():
        if key in reserved: raise RuntimeError("export option is controlled by the CLI: " + key)
        if key not in props or key == "rna_type": raise RuntimeError("unknown export option for this Blender/format: " + key)
        prop = props[key]
        def scalar(v):
            if prop.type == "BOOLEAN": return isinstance(v, bool)
            if prop.type == "INT": return type(v) is int and prop.hard_min <= v <= prop.hard_max
            if prop.type == "FLOAT": return type(v) in (int, float) and math.isfinite(v) and prop.hard_min <= v <= prop.hard_max
            if prop.type == "STRING": return isinstance(v, str)
            if prop.type == "ENUM": return isinstance(v, str) and v in prop.enum_items.keys()
            return False
        if prop.type == "ENUM" and prop.is_enum_flag:
            valid = isinstance(value, list) and all(scalar(v) for v in value)
            value = set(value) if valid else value
        elif prop.is_array:
            valid = isinstance(value, list) and len(value) == prop.array_length and all(scalar(v) for v in value)
        else: valid = scalar(value)
        if not valid: raise RuntimeError("invalid type, range or enum value for export option: " + key)
        validated[key] = value
    state = op(**{**defaults, **validated})
    if "FINISHED" not in state: raise RuntimeError("export operator did not finish: " + str(state))
    result["export_options"] = options

if ext in ("glb", "gltf"): _export(bpy.ops.export_scene.gltf, {"filepath": p, "export_format": "GLB" if ext == "glb" else "GLTF_SEPARATE", "use_selection": sel, "export_animations": anim})
elif ext == "obj":
    if "obj_export" in wm: _export(bpy.ops.wm.obj_export, {"filepath": p, "export_selected_objects": sel})
    else: _export(bpy.ops.export_scene.obj, {"filepath": p, "use_selection": sel})
elif ext == "fbx": _export(bpy.ops.export_scene.fbx, {"filepath": p, "use_selection": sel, "bake_anim": anim})
elif ext == "stl":
    if "stl_export" in wm: _export(bpy.ops.wm.stl_export, {"filepath": p, "export_selected_objects": sel})
    else: _export(bpy.ops.export_mesh.stl, {"filepath": p, "use_selection": sel})
elif ext == "ply":
    if "ply_export" in wm: _export(bpy.ops.wm.ply_export, {"filepath": p, "export_selected_objects": sel})
    else: _export(bpy.ops.export_mesh.ply, {"filepath": p, "use_selection": sel})
elif ext in ("usd", "usda", "usdc", "usdz"):
    if "usd_export" not in wm: raise RuntimeError("USD export is unavailable in this Blender build (doctor.io.usd.export=false)")
    _export(bpy.ops.wm.usd_export, {"filepath": p, "selected_objects_only": sel, "export_animation": anim})
else: raise RuntimeError("unsupported format: ." + ext + " (glb gltf obj fbx stl ply usd usda usdc usdz)")

_bytes = os.path.getsize(p)
if _bytes <= 0: raise RuntimeError("export reported success but produced an empty artifact: " + p)
_h = _hashlib.sha256()
with open(p, "rb") as _f:
    for _chunk in iter(lambda: _f.read(1024 * 1024), b""): _h.update(_chunk)
result["exported"] = {"file": p, "format": ext, "bytes": _bytes, "objects": len(_scene_objs),
    "artifact": {"path": p, "kind": "model", "format": ext, "bytes": _bytes, "sha256": _h.hexdigest()},
    "animation": {"objects": before["animated"], "keyframes": before["keyframes"], "exported": anim}}

if PARAMS.get("verify"):
    fid = {"checked": False}
    try:
        # Safe to wipe: nothing is saved after an export, so the loaded scene is
        # scratch from here on. Read the file back the way a consumer would.
        bpy.ops.wm.read_factory_settings(use_empty=True)
        if ext in ("glb", "gltf"): bpy.ops.import_scene.gltf(filepath=p)
        elif ext == "obj": (bpy.ops.wm.obj_import(filepath=p) if "obj_import" in wm else bpy.ops.import_scene.obj(filepath=p))
        elif ext == "fbx": bpy.ops.import_scene.fbx(filepath=p)
        elif ext == "stl": (bpy.ops.wm.stl_import(filepath=p) if "stl_import" in wm else bpy.ops.import_mesh.stl(filepath=p))
        elif ext == "ply": (bpy.ops.wm.ply_import(filepath=p) if "ply_import" in wm else bpy.ops.import_mesh.ply(filepath=p))
        elif ext in ("usd", "usda", "usdc", "usdz"): bpy.ops.wm.usd_import(filepath=p)
        else: raise RuntimeError("no importer for ." + ext)
        after = _census(list(bpy.context.scene.objects))
        fields = [k for k in CARRIES.get(ext, ["meshes", "verts"]) if anim or k != "animated"]
        if (PARAMS.get("options") or {}).get("export_apply"): fields.append("evaluated_verts")
        # More is fine (glTF splits verts at UV/normal seams); less is a loss.
        lost = [{"field": k, "scene": before[k], "file": after[k]} for k in fields if after[k] < before[k]]
        fid = {"checked": True, "ok": not lost, "compared": fields,
            "scene": {k: before[k] for k in fields}, "file": {k: after[k] for k in fields}, "lost": lost,
            "detail": {"scene_color_channels": before["color_channels"], "file_color_channels": after["color_channels"],
                "scene_geometry": before["evaluated_geometry"], "file_geometry": after["evaluated_geometry"]}}
    except Exception as e:
        fid = {"checked": False, "reason": "readback failed: %s" % e}
    result["exported"]["fidelity"] = fid`;

commands.export = async (args, ctx) => {
  const { flags, positional } = fdn.parseArgs(args, ['blend', 'batch', 'format', 'animations', 'options', 'manifest', ...COMMON_FLAGS]);
  const outArg = positional[0];
  const verify = !flags['no-verify'];
  const animFlag = flags.animations === undefined ? 'on' : String(flags.animations).toLowerCase();
  if (!['on', 'off'].includes(animFlag)) { show({ ok: false, error: `invalid --animations: ${flags.animations} (use on|off)` }, ctx); process.exit(1); }
  const animations = animFlag === 'on';
  if (flags.strict && !verify) { show({ ok: false, error: '--strict requires readback verification; remove --no-verify' }, ctx); process.exit(1); }
  let options = {};
  try {
    if (flags.options !== undefined) {
      if (flags.options === true) throw new Error('missing value for --options');
      const raw = String(flags.options);
      options = JSON.parse(raw.startsWith('@') ? readFileSync(resolve(raw.slice(1)), 'utf8') : raw);
      if (!options || typeof options !== 'object' || Array.isArray(options)) throw new Error('--options must be a JSON object or @file.json');
    }
    if ((flags.resume || flags.manifest) && !flags.batch) throw new Error('--manifest and --resume require --batch');
  } catch (e) { show({ ok: false, error: e.message }, ctx); process.exit(1); }
  const finish = r => {
    try { if (r.ok) exportBundleProof(r.result); }
    catch (e) { r.ok = false; r.error = `export artifact verification failed: ${e.message}`; }
    const fid = r.result?.exported?.fidelity;
    if (r.ok && flags.strict && (!fid?.checked || !fid.ok)) {
      r.ok = false;
      r.error = !fid?.checked ? `export verification unavailable: ${fid?.reason || 'no readback result'}`
        : `export degraded: ${fid.lost.map(l => `${l.field} ${l.scene} -> ${l.file}`).join(', ')}`;
    }
    return r;
  };
  if (flags.batch) {
    const files = globFiles(String(flags.batch));
    if (!files.length) {
      show({ ok: false, error: `--batch matched no files: ${flags.batch}`, hint: 'quote the pattern so the shell does not expand it first; * and ? are supported in the last path segment, ** is not' }, ctx);
      process.exit(1);
    }
    // In batch mode the positional is the output DIRECTORY and --format the extension.
    const fmt = String(flags.format || '').replace(/^\./, '');
    if (!fmt) {
      show({ ok: false, error: 'missing --format in batch mode', usage: 'blender-cli export <out-dir> --batch "blends/*.blend" --format glb' }, ctx);
      process.exit(1);
    }
    const outDir = resolve(outArg || process.cwd());
    let agg;
    try {
      const outputs = files.map(f => join(outDir, `${stemOf(f)}.${fmt}`));
      if (new Set(outputs).size !== outputs.length) throw new Error('batch output names collide');
      if (flags.manifest && outputs.includes(resolve(flags.manifest))) throw new Error('manifest must not overwrite an export output');
      agg = await batchRun(files, f => finish(runBlender(EXPORT_BODY, { blend: f,
        params: { out: join(outDir, `${stemOf(f)}.${fmt}`), selected: !!flags.selected, verify, animations, options }, flags })),
        batchOptions(flags, 'export', { outDir, fmt, verify, animations, options }));
    } catch (e) { agg = { ok: false, error: e.message }; }
    show(agg, ctx); if (!agg.ok) process.exit(1);
    return;
  }
  if (!outArg) {
    show({ ok: false, error: 'missing output path', usage: 'blender-cli export <out.glb|obj|fbx|stl|ply|usd> [--blend f] [--selected] [--no-verify] [--strict]' }, ctx);
    process.exit(1);
  }
  const r = finish(runBlender(EXPORT_BODY, { blend: flags.blend, params: { out: resolve(outArg), selected: !!flags.selected, verify, animations, options }, flags }));
  show(r, ctx); if (!r.ok) process.exit(1);
};

// `blender-cli verify [--blend f]` — lint the scene before you spend a render on
// it. The earlier prototype was dropped because it called any two touching
// bounding boxes an overlap, which is most of a normal scene; here an overlap
// has to penetrate by more than --tolerance on ALL THREE axes before it counts,
// and the depth is reported so the agent can judge for itself. Findings are
// tiered error/warn/info and --fail-on decides which tier is worth a non-zero exit.
const VERIFY_BODY = `from mathutils import Vector
import math as _m
sc = bpy.context.scene
tol = float(PARAMS.get("tolerance") or 0.001)
F = []
def add(sev, check, detail, obj=None, **extra):
    f = {"severity": sev, "check": check, "detail": detail}
    if obj is not None: f["object"] = obj
    f.update(extra)
    F.append(f)

objs = list(sc.objects)
meshes = [o for o in objs if o.type == "MESH" and o.data]
cams = [o for o in objs if o.type == "CAMERA"]
lights = [o for o in objs if o.type == "LIGHT"]

if not cams: add("error", "no_camera", "scene has no camera; render will fail")
if not lights: add("info", "no_light", "scene has no light; Cycles/EEVEE output will be black unless the world lights it")
for image in bpy.data.images:
    if image.source != "FILE" or image.packed_file or not image.filepath: continue
    path = bpy.path.abspath(image.filepath)
    if not os.path.isfile(path):
        add("error", "missing_image", "external image file is missing; material or world may render without its texture",
            image.name, path=path)

def world_aabb(o):
    cs = [o.matrix_world @ Vector(c) for c in o.bound_box]
    return (Vector((min(c.x for c in cs), min(c.y for c in cs), min(c.z for c in cs))),
            Vector((max(c.x for c in cs), max(c.y for c in cs), max(c.z for c in cs))))

for o in objs:
    vals = list(o.location) + list(o.rotation_euler) + list(o.scale)
    if any(not _m.isfinite(v) for v in vals):
        add("error", "non_finite_transform", "NaN/inf in transform; this object will corrupt exports and renders", o.name)
        continue
    if o.type == "MESH":
        if len(o.data.vertices) == 0:
            add("error", "empty_mesh", "mesh has no vertices", o.name)
        if not o.data.materials or all(m is None for m in o.data.materials):
            add("info", "no_material", "mesh has no material; renders with the default grey", o.name)
    s = list(o.scale)
    if any(abs(v) < 1e-9 for v in s):
        add("error", "degenerate_scale", "a scale axis is zero; geometry is flattened", o.name, scale=[round(v, 6) for v in s])
    elif any(v < 0 for v in s):
        add("warn", "negative_scale", "negative scale flips normals; exporters and shading handle this inconsistently", o.name, scale=[round(v, 6) for v in s])
    elif o.type == "MESH" and max(abs(v) for v in s) - min(abs(v) for v in s) > 1e-4:
        add("warn", "non_uniform_scale", "unapplied non-uniform scale distorts normals, modifiers and physics; apply it before export", o.name, scale=[round(v, 6) for v in s])

# Mesh health: what the transform checks cannot see. Loose geometry and
# zero-area faces vanish in exporters, non-manifold edges break booleans and
# printing, inconsistent winding breaks shading and culling, and a game-engine
# collider (UCX_/UBX_/USP_/UCP_ prefix) that is not convex imports without a
# word and collides wrongly in the engine. --no-mesh skips this pass.
import bmesh
mesh_stats = {}
MESH_LIMIT = 500000
COLLIDER_PREFIXES = ("UCX_", "UBX_", "USP_", "UCP_")
if not PARAMS.get("no_mesh"):
    for o in meshes:
        me = o.data
        if len(me.vertices) > MESH_LIMIT:
            add("info", "mesh_check_skipped", "%d vertices (> %d); mesh checks skipped" % (len(me.vertices), MESH_LIMIT), o.name)
            continue
        bm = bmesh.new(); bm.from_mesh(me)
        loose_v = sum(1 for v in bm.verts if not v.link_edges)
        loose_e = sum(1 for e in bm.edges if not e.link_faces)
        boundary = sum(1 for e in bm.edges if e.is_boundary)
        nonman = sum(1 for e in bm.edges if e.link_faces and not e.is_manifold and not e.is_boundary)
        zero_area = sum(1 for f in bm.faces if f.calc_area() < 1e-9)
        manifold = [e for e in bm.edges if e.is_manifold]
        inconsistent = sum(1 for e in manifold if not e.is_contiguous)
        inverted = False
        if manifold and boundary == 0 and inconsistent == 0:
            neg = sum(1 for e in manifold if e.calc_face_angle_signed(0.0) < -1e-5)
            pos = sum(1 for e in manifold if e.calc_face_angle_signed(0.0) > 1e-5)
            inverted = neg > 0 and pos == 0
        ngons = sum(1 for f in bm.faces if len(f.verts) > 4)
        st = {"verts": len(bm.verts), "edges": len(bm.edges), "faces": len(bm.faces), "boundary_edges": boundary,
            "non_manifold_edges": nonman, "loose_verts": loose_v, "loose_edges": loose_e, "zero_area_faces": zero_area,
            "inconsistent_normals": inconsistent, "inverted_normals": inverted, "ngons": ngons,
            "modifiers": [m.type for m in o.modifiers]}
        if loose_v or loose_e: add("warn", "loose_geometry", "%d loose vertices, %d loose edges; most exporters drop them" % (loose_v, loose_e), o.name)
        if nonman: add("warn", "non_manifold", "%d non-manifold edges (3+ faces or wire); booleans, printing and some exporters misbehave" % nonman, o.name)
        if zero_area: add("warn", "zero_area_faces", "%d zero-area faces" % zero_area, o.name)
        if inconsistent: add("warn", "inconsistent_normals", "%d edges where adjacent faces wind in opposite directions; shading and backface culling break" % inconsistent, o.name)
        if inverted: add("warn", "inverted_normals", "every face normal points inward on this closed mesh", o.name)
        if boundary and len(bm.faces): add("info", "open_mesh", "%d boundary edges; mesh is not watertight" % boundary, o.name)
        if o.name.upper().startswith(COLLIDER_PREFIXES):
            bm2 = bm.copy(); bmesh.ops.triangulate(bm2, faces=bm2.faces[:])
            ext_ = max((max(v.co[k] for v in bm2.verts) - min(v.co[k] for v in bm2.verts)) for k in range(3)) if bm2.verts else 1.0
            eps = 1e-5 * max(ext_, 1e-6)
            concave = False
            for f in bm2.faces:
                c = f.calc_center_median(); nrm = f.normal
                if any((v.co - c).dot(nrm) > eps for v in bm2.verts): concave = True; break
            bm2.free()
            st["convex"] = not concave
            if concave: add("error", "concave_collider", "collision mesh is not convex; UCX_-style colliders must be convex hulls (engines import them silently and collide wrongly)", o.name)
        bm.free()
        types = st["modifiers"]
        if "MULTIRES" in types and types[-1] != "MULTIRES":
            add("error", "multires_not_last", "Multires must be the last modifier to sculpt and bake correctly; stack is " + " > ".join(types), o.name)
        if "MIRROR" in types and "SUBSURF" in types and types.index("MIRROR") > types.index("SUBSURF"):
            add("warn", "mirror_after_subsurf", "Mirror after Subdivision leaves a visible seam; put Mirror first", o.name)
        if types: add("info", "modifiers_pending", "%d unapplied modifier(s): %s (exporters apply them; verify counts the base mesh)" % (len(types), ", ".join(types)), o.name)
        mesh_stats[o.name] = st

# Overlap: real interpenetration on every axis, not a shared face or edge.
for i in range(len(meshes)):
    for j in range(i + 1, len(meshes)):
        a, b = meshes[i], meshes[j]
        amin, amax = world_aabb(a); bmin, bmax = world_aabb(b)
        depth = [min(amax[k], bmax[k]) - max(amin[k], bmin[k]) for k in range(3)]
        if all(d > tol for d in depth):
            add("warn", "overlap", "bounding boxes interpenetrate on all three axes", a.name,
                other=b.name, depth=[round(d, 5) for d in depth], tolerance=tol)

# Off-camera: project the 8 corners; an object is only off-frame if its whole
# projected box misses [0,1]x[0,1]. Testing corners individually would flag any
# object bigger than the frame, which is usually the hero object.
if cams and sc.camera:
    try:
        from bpy_extras.object_utils import world_to_camera_view as _w2c
        for o in meshes:
            cs = [o.matrix_world @ Vector(c) for c in o.bound_box]
            pts = [_w2c(sc, sc.camera, c) for c in cs]
            front = [p for p in pts if p.z > 0]
            if not front:
                add("warn", "off_camera", "entirely behind the camera", o.name)
                continue
            xs = [p.x for p in front]; ys = [p.y for p in front]
            if max(xs) < 0 or min(xs) > 1 or max(ys) < 0 or min(ys) > 1:
                add("warn", "off_camera", "outside the camera frame", o.name,
                    ndc_x=[round(min(xs), 3), round(max(xs), 3)], ndc_y=[round(min(ys), 3), round(max(ys), 3)])
    except Exception as e:
        add("info", "off_camera_skipped", "frustum check unavailable: %s" % e)

counts = {"error": 0, "warn": 0, "info": 0}
for f in F: counts[f["severity"]] += 1
result["verified"] = {"scene": sc.name, "objects": len(objs), "meshes": len(meshes),
    "tolerance": tol, "errors": counts["error"], "warnings": counts["warn"],
    "infos": counts["info"], "findings": F, "mesh": mesh_stats}`;

commands.verify = async (args, ctx) => {
  const { flags } = fdn.parseArgs(args, ['blend', 'tolerance', 'fail-on', ...COMMON_FLAGS]);
  const failOn = flags['fail-on'] || 'error';
  if (!['error', 'warn', 'none'].includes(failOn)) {
    show({ ok: false, error: `invalid --fail-on: ${failOn} (use error|warn|none)` }, ctx); process.exit(1);
  }
  if (flags.tolerance !== undefined && !(Number(flags.tolerance) >= 0)) {
    show({ ok: false, error: `invalid --tolerance: ${flags.tolerance} (a non-negative number, e.g. 0.001)` }, ctx); process.exit(1);
  }
  const r = runBlender(VERIFY_BODY, { blend: flags.blend, params: { tolerance: flags.tolerance ?? null, no_mesh: !!flags['no-mesh'] }, flags });
  const v = r?.result?.verified;
  if (r.ok && v && failOn !== 'none') {
    const bad = failOn === 'warn' ? v.errors + v.warnings : v.errors;
    if (bad > 0) { r.ok = false; r.error = `scene verify failed: ${v.errors} error(s), ${v.warnings} warning(s) (--fail-on ${failOn})`; }
  }
  show(r, ctx); if (!r.ok) process.exit(1);
};

// `blender-cli new <name> [--save path.blend]` — scaffold a clean project with camera + light.
commands.new = async (args, ctx) => {
  const { flags, positional } = fdn.parseArgs(args, ['save', ...COMMON_FLAGS]);
  const name = positional.join(' ') || 'untitled';
  const save = flags.save || join(process.cwd(), `${name.replace(/\s+/g, '_')}.blend`);
  const body = `bpy.ops.wm.read_factory_settings(use_empty=True)
sc = bpy.context.scene
sc.name = PARAMS["name"]
# camera
cam_data = bpy.data.cameras.new("Camera"); cam = bpy.data.objects.new("Camera", cam_data)
sc.collection.objects.link(cam); sc.camera = cam
cam.location = (7.36, -6.93, 4.96); cam.rotation_euler = (1.109, 0.0, 0.815)
# key light
light_data = bpy.data.lights.new("Key", type="AREA"); light_data.energy = 1000
light = bpy.data.objects.new("Key", light_data); sc.collection.objects.link(light)
light.location = (4.0, 1.0, 6.0)
sc.render.resolution_x = 1920; sc.render.resolution_y = 1080
result["scaffolded"] = {"scene": sc.name, "camera": cam.name, "light": light.name}`;
  const r = runBlender(body, { save, params: { name }, flags });
  show(r, ctx); if (!r.ok) process.exit(1);
};

// `blender-cli snapshot` — look at what you built without spending a real render.
// Workbench renders orthographic front/right/top views plus a fitted 3/4
// perspective, tiles them into one PNG, and reports per-view coverage (fraction
// of pixels the geometry actually occupies, via the alpha channel), the
// occupied bounding box and mean luminance, so an agent can tell "framed and
// visible" from "blank" or "off to one side" without an image model in the loop.
const SNAPSHOT_BODY = `import math as _m
from mathutils import Vector, Euler
import numpy as np
sc = bpy.context.scene
if PARAMS.get("frame") is not None: sc.frame_set(int(PARAMS["frame"]))
VISIBLE = ("MESH", "CURVE", "FONT", "SURFACE", "META")
targets = [o for o in sc.objects if o.type in VISIBLE and o.visible_get()]
if not targets: raise RuntimeError("nothing to snapshot: the scene has no visible mesh/curve/text objects")
lo = [1e30, 1e30, 1e30]; hi = [-1e30, -1e30, -1e30]
for o in targets:
    for c in o.bound_box:
        w = o.matrix_world @ Vector(c)
        for k in range(3):
            lo[k] = min(lo[k], w[k]); hi[k] = max(hi[k], w[k])
lo = Vector(lo); hi = Vector(hi)
center = (lo + hi) / 2; size = hi - lo
extent = max(size.x, size.y, size.z, 1e-6)
W, H = [int(x) for x in str(PARAMS.get("res") or "512x384").lower().split("x")]
aspect = W / H
sc.render.engine = "BLENDER_WORKBENCH"
sc.render.resolution_x, sc.render.resolution_y = W, H
sc.render.resolution_percentage = 100
sc.render.film_transparent = True
sc.render.image_settings.file_format = "PNG"
sc.render.image_settings.color_mode = "RGBA"
sc.render.use_file_extension = False
sh = sc.display.shading
mode = str(PARAMS.get("shading") or "random").lower()
if mode not in ("random", "material", "solid"): raise RuntimeError("--shading must be random|material|solid")
sh.light = "STUDIO"; sh.show_object_outline = True
sh.type = "SOLID"
sh.color_type = {"random": "RANDOM", "material": "MATERIAL", "solid": "SINGLE"}[mode]
cam_data = bpy.data.cameras.new("__bcli_snapshot"); cam = bpy.data.objects.new("__bcli_snapshot", cam_data)
sc.collection.objects.link(cam); sc.camera = cam
HALF = _m.pi / 2
VIEWS = {
    "front":  (Vector((0, -1, 0)), Euler((HALF, 0, 0)), "ortho"),
    "back":   (Vector((0, 1, 0)),  Euler((HALF, 0, _m.pi)), "ortho"),
    "right":  (Vector((1, 0, 0)),  Euler((HALF, 0, HALF)), "ortho"),
    "left":   (Vector((-1, 0, 0)), Euler((HALF, 0, -HALF)), "ortho"),
    "top":    (Vector((0, 0, 1)),  Euler((0, 0, 0)), "ortho"),
    "bottom": (Vector((0, 0, -1)), Euler((_m.pi, 0, 0)), "ortho"),
    "persp":  (Vector((1, -1, 0.8)).normalized(), None, "persp"),
}
names = [v.strip().lower() for v in str(PARAMS.get("views") or "front,right,top,persp").split(",") if v.strip()]
bad = [n for n in names if n not in VIEWS]
if bad: raise RuntimeError("unknown view(s): " + ", ".join(bad) + " (use " + ", ".join(VIEWS) + ")")
if not names: raise RuntimeError("no views given")
tiles = []; views = []
for name in names:
    direction, rot, kind = VIEWS[name]
    if kind == "persp":
        cam_data.type = "PERSP"; cam_data.lens = 50
        radius = max(size.length / 2, 1e-6)
        fov = 2 * _m.atan(cam_data.sensor_width / (2 * cam_data.lens))
        vfov = 2 * _m.atan(_m.tan(fov / 2) / aspect) if aspect > 1 else fov
        dist = radius / _m.sin(min(fov, vfov) / 2) * 1.1
        cam.location = center + direction * dist
        cam.rotation_euler = (center - cam.location).to_track_quat("-Z", "Y").to_euler()
    else:
        cam_data.type = "ORTHO"
        dist = extent * 3.0
        cam.location = center + direction * dist
        cam.rotation_euler = rot
        if name in ("front", "back"): ex, ey = size.x, size.z
        elif name in ("right", "left"): ex, ey = size.y, size.z
        else: ex, ey = size.x, size.y
        cam_data.ortho_scale = max(ex, ey * aspect, 1e-6) * 1.15
    cam_data.clip_start = 0.01; cam_data.clip_end = max(dist * 4, 100.0)
    fpath = os.path.join(PARAMS["tmp"], "view_" + name + ".png")
    sc.render.filepath = fpath
    bpy.ops.render.render(write_still=True)
    img = bpy.data.images.load(fpath)
    px = np.array(img.pixels[:], dtype=np.float32).reshape(H, W, 4)
    bpy.data.images.remove(img)
    alpha = px[:, :, 3] > 0.5
    cov = float(alpha.mean())
    if alpha.any():
        ys, xs = np.nonzero(alpha)
        bbox = [round(float(xs.min()) / W, 3), round(float(ys.min()) / H, 3), round(float(xs.max() + 1) / W, 3), round(float(ys.max() + 1) / H, 3)]
        lum = float((0.2126 * px[:, :, 0] + 0.7152 * px[:, :, 1] + 0.0722 * px[:, :, 2])[alpha].mean())
    else:
        bbox = None; lum = 0.0
    views.append({"view": name, "projection": kind, "coverage": round(cov, 4), "bbox": bbox, "luminance": round(lum, 4), "blank": cov < 0.002})
    tiles.append(px)
n = len(tiles); cols = 2 if n > 1 else 1; rows = (n + cols - 1) // cols
bg = float(PARAMS.get("bg")) if PARAMS.get("bg") is not None else 0.18
sheet = np.full((rows * H, cols * W, 4), (bg, bg, bg, 1.0), dtype=np.float32)
for i, t in enumerate(tiles):
    r_, c_ = divmod(i, cols)
    a = t[:, :, 3:4]
    y0 = (rows - 1 - r_) * H
    sheet[y0:y0 + H, c_ * W:(c_ + 1) * W, :3] = t[:, :, :3] * a + bg * (1 - a)
img = bpy.data.images.new("__bcli_sheet", cols * W, rows * H, alpha=True)
img.pixels.foreach_set(sheet.ravel())
out = PARAMS["out"]
os.makedirs(os.path.dirname(out) or ".", exist_ok=True)
img.filepath_raw = out; img.file_format = "PNG"; img.save()
result["snapshot"] = {"sheet": out, "bytes": os.path.getsize(out), "tile": [W, H], "grid": [cols, rows],
    "layout": [names[r_ * cols:(r_ + 1) * cols] for r_ in range(rows)], "views": views,
    "bounds": {"min": [round(v, 4) for v in lo], "max": [round(v, 4) for v in hi], "size": [round(v, 4) for v in size], "center": [round(v, 4) for v in center]},
    "objects": len(targets), "shading": mode, "frame": sc.frame_current}
blank = [v["view"] for v in views if v["blank"]]
if blank: result["snapshot"]["warnings"] = ["blank view(s): " + ", ".join(blank) + " (nothing visible from there)"]`;

commands.snapshot = async (args, ctx) => {
  const { flags } = fdn.parseArgs(args, ['blend', 'out', 'views', 'res', 'shading', 'frame', 'bg', ...COMMON_FLAGS]);
  const out = resolve(flags.out || join(process.cwd(), 'snapshot.png'));
  if (flags.res !== undefined && !/^\d+x\d+$/i.test(String(flags.res))) { show({ ok: false, error: `invalid --res: ${flags.res} (WxH, e.g. 512x384)` }, ctx); process.exit(1); }
  const tmp = mkdtempSync(join(tmpdir(), 'blender-cli-snap-'));
  let r;
  try {
    r = runBlender(SNAPSHOT_BODY, { blend: flags.blend, params: {
      out, tmp, views: flags.views || null, res: flags.res || null, shading: flags.shading || null,
      frame: flags.frame ?? null, bg: flags.bg ?? null,
    }, flags });
  } finally { rmSync(tmp, { recursive: true, force: true }); }
  show(r, ctx); if (!r.ok) process.exit(1);
};

// Declarative acceptance composes the existing scene verifier and optional
// multi-view snapshot, then writes a receipt bound to the spec and .blend hash.
const ACCEPT_ASSERTIONS = `spec = PARAMS["spec"]
failures = []
names = {o.name: o for o in bpy.context.scene.objects if not o.name.startswith("__bcli_")}
for req in spec.get("required_objects", []):
    if isinstance(req, str):
        if req not in names: failures.append({"check": "required_object", "expected": req, "detail": "missing"})
    elif isinstance(req, dict):
        n = req.get("name"); o = names.get(n)
        if o is None: failures.append({"check": "required_object", "expected": n, "detail": "missing"})
        elif req.get("type") and o.type != str(req["type"]).upper():
            failures.append({"check": "required_object_type", "object": n, "expected": str(req["type"]).upper(), "actual": o.type})
for pat in spec.get("forbidden_objects", []):
    import fnmatch as _fnmatch
    hit = sorted(n for n in names if _fnmatch.fnmatch(n, str(pat)))
    if hit: failures.append({"check": "forbidden_objects", "pattern": pat, "found": hit})
for typ, minimum in spec.get("required_types", {}).items():
    actual = sum(1 for o in names.values() if o.type == str(typ).upper())
    if actual < int(minimum): failures.append({"check": "required_type", "type": str(typ).upper(), "expected_min": int(minimum), "actual": actual})
if spec.get("min_objects") is not None and len(names) < int(spec["min_objects"]):
    failures.append({"check": "min_objects", "expected": int(spec["min_objects"]), "actual": len(names)})
if spec.get("frame_range") is not None:
    expected = [int(x) for x in spec["frame_range"]]
    actual = [bpy.context.scene.frame_start, bpy.context.scene.frame_end]
    if actual != expected: failures.append({"check": "frame_range", "expected": expected, "actual": actual})
max_errors = int(spec.get("max_errors", 0))
if result["verified"]["errors"] > max_errors:
    failures.append({"check": "verify_errors", "expected_max": max_errors, "actual": result["verified"]["errors"]})
if spec.get("max_warnings") is not None and result["verified"]["warnings"] > int(spec["max_warnings"]):
    failures.append({"check": "verify_warnings", "expected_max": int(spec["max_warnings"]), "actual": result["verified"]["warnings"]})
snap_spec = spec.get("snapshot")
if snap_spec:
    minimum = float(snap_spec.get("min_coverage", 0.002)) if isinstance(snap_spec, dict) else 0.002
    for view in result["snapshot"]["views"]:
        if view["coverage"] < minimum:
            failures.append({"check": "snapshot_coverage", "view": view["view"], "expected_min": minimum, "actual": view["coverage"]})
result["acceptance"] = {"passed": not failures, "failures": failures, "objects": len(names),
    "required_objects": len(spec.get("required_objects", [])), "spec_version": spec.get("version", 1)}`;

function loadAcceptanceSpec(specPath) {
  const path = resolve(specPath);
  if (!existsSync(path)) throw new Error(`acceptance spec not found: ${path}`);
  let spec;
  const raw = readFileSync(path, 'utf8');
  try { spec = JSON.parse(raw); } catch (e) { throw new Error(`invalid acceptance JSON: ${e.message}`); }
  const object = x => x && typeof x === 'object' && !Array.isArray(x);
  const text = x => typeof x === 'string' && x.trim().length > 0;
  const number = x => typeof x === 'number' && Number.isFinite(x);
  const count = x => Number.isInteger(x) && x >= 0;
  const keys = (value, allowed, where) => {
    if (!object(value)) throw new Error(`${where} must be a JSON object`);
    for (const key of Object.keys(value)) if (!allowed.includes(key)) throw new Error(`unknown ${where} field: ${key}`);
  };
  keys(spec, ['version', 'required_objects', 'forbidden_objects', 'required_types', 'frame_range', 'min_objects',
    'max_errors', 'max_warnings', 'tolerance', 'mesh', 'snapshot'], 'acceptance');
  if (spec.version !== undefined && spec.version !== 1) throw new Error('acceptance version must be 1');
  if (spec.required_objects !== undefined) {
    if (!Array.isArray(spec.required_objects)) throw new Error('required_objects must be a list');
    for (const req of spec.required_objects) {
      if (text(req)) continue;
      keys(req, ['name', 'type'], 'required_objects');
      if (!text(req.name) || req.type !== undefined && !text(req.type)) throw new Error('required_objects entries require a non-empty name and optional type');
    }
  }
  if (spec.forbidden_objects !== undefined && (!Array.isArray(spec.forbidden_objects) || !spec.forbidden_objects.every(text))) throw new Error('forbidden_objects must be a list of non-empty patterns');
  if (spec.required_types !== undefined && (!object(spec.required_types) || !Object.entries(spec.required_types).every(([key, value]) => text(key) && count(value)))) throw new Error('required_types must map type names to non-negative integer counts');
  if (spec.frame_range !== undefined && (!Array.isArray(spec.frame_range) || spec.frame_range.length !== 2 || !spec.frame_range.every(Number.isInteger) || spec.frame_range[0] > spec.frame_range[1])) throw new Error('frame_range must be ordered [start,end] integers');
  for (const key of ['min_objects', 'max_errors', 'max_warnings']) if (spec[key] !== undefined && !count(spec[key])) throw new Error(`${key} must be a non-negative integer`);
  if (spec.tolerance !== undefined && (!number(spec.tolerance) || spec.tolerance < 0)) throw new Error('tolerance must be a non-negative number');
  if (spec.mesh !== undefined && typeof spec.mesh !== 'boolean') throw new Error('mesh must be true or false');
  if (spec.snapshot !== undefined && typeof spec.snapshot !== 'boolean' && !object(spec.snapshot)) throw new Error('snapshot must be true, false, or an object');
  if (object(spec.snapshot)) {
    const snap = spec.snapshot;
    keys(snap, ['out', 'views', 'res', 'shading', 'frame', 'bg', 'min_coverage'], 'snapshot');
    if (snap.out !== undefined && !text(snap.out)) throw new Error('snapshot.out must be a non-empty path');
    for (const key of ['bg', 'min_coverage']) if (snap[key] !== undefined && (!number(snap[key]) || snap[key] < 0 || snap[key] > 1)) throw new Error(`snapshot.${key} must be a number between 0 and 1`);
    if (snap.res !== undefined && (typeof snap.res !== 'string' || !/^[1-9]\d*x[1-9]\d*$/i.test(snap.res))) throw new Error('snapshot.res must be positive WxH');
    if (snap.frame !== undefined && !Number.isInteger(snap.frame)) throw new Error('snapshot.frame must be an integer');
    if (snap.shading !== undefined && !['random', 'material', 'solid'].includes(snap.shading)) throw new Error('snapshot.shading must be random|material|solid');
    if (snap.views !== undefined && (!text(snap.views) || !snap.views.split(',').every(v => ['front', 'back', 'right', 'left', 'top', 'bottom', 'persp'].includes(v.trim().toLowerCase())))) throw new Error('snapshot.views contains an unsupported view');
  }
  return { path, spec, proof: { path, bytes: Buffer.byteLength(raw), sha256: createHash('sha256').update(raw).digest('hex') } };
}

function runAcceptance(specArg, { blend, receipt, flags, snapshotOut }) {
  if (!blend || typeof blend !== 'string') return { ok: false, error: '--blend is required so the receipt can bind to a source scene' };
  if (!existsSync(blend)) return { ok: false, error: `blend file not found: ${resolve(blend)}` };
  let loaded;
  try { loaded = loadAcceptanceSpec(specArg); } catch (e) { return { ok: false, error: e.message }; }
  const snapSpec = loaded.spec.snapshot;
  const snap = snapSpec ? (typeof snapSpec === 'object' ? snapSpec : {}) : null;
  const out = snap ? snapshotOut || resolve(dirname(loaded.path), snap.out || `${basename(loaded.path).replace(/\.json$/i, '')}.snapshot.png`) : null;
  const receiptPath = resolve(receipt || `${loaded.path.replace(/\.json$/i, '')}.receipt.json`);
  const protectedPaths = [resolve(blend), loaded.path];
  if (protectedPaths.includes(receiptPath) || out && (protectedPaths.includes(resolve(out)) || resolve(out) === receiptPath)) {
    return { ok: false, error: 'acceptance outputs must not overwrite the source scene, spec or each other' };
  }
  const sourceProof = fileProof(blend);
  const tmp = snap ? mkdtempSync(join(tmpdir(), 'blender-cli-accept-')) : null;
  const params = {
    spec: loaded.spec, tolerance: loaded.spec.tolerance ?? null, no_mesh: loaded.spec.mesh === false,
    ...(snap ? { out, tmp, views: snap.views || null, res: snap.res || null, shading: snap.shading || null,
      frame: snap.frame ?? null, bg: snap.bg ?? null } : {}),
  };
  const body = `${VERIFY_BODY}\n${snap ? SNAPSHOT_BODY : ''}\n${ACCEPT_ASSERTIONS}`;
  let r;
  try { r = runBlender(body, { blend, params, flags }); }
  finally { if (tmp) rmSync(tmp, { recursive: true, force: true }); }
  if (r.ok && r.result?.acceptance && !r.result.acceptance.passed) {
    r.ok = false; r.error = `acceptance failed: ${r.result.acceptance.failures.length} requirement(s) unmet`;
  }
  if (!matchingProof(sourceProof) || !matchingProof(loaded.proof)) {
    r.ok = false; r.error = 'source scene or acceptance spec changed during verification; retry';
  }
  try {
    const source = sourceProof;
    const snapshot = out && existsSync(out) ? fileProof(out) : null;
    const value = {
      schema_version: 1, tool: PKG.name, tool_version: PKG.version, created_at: new Date().toISOString(),
      passed: r.ok === true, spec: loaded.proof, source, snapshot,
      verified: r.result?.verified || null, acceptance: r.result?.acceptance || null,
      error: r.error || null,
    };
    writeJsonAtomic(receiptPath, value);
    r.receipt = receiptPath;
    if (r.result?.acceptance) r.result.acceptance.receipt = receiptPath;
  } catch (e) {
    return { ok: false, error: `could not write acceptance receipt: ${e.message}`, result: r.result };
  }
  return r;
}

commands.accept = async (args, ctx) => {
  const { flags, positional } = fdn.parseArgs(args, ['blend', 'receipt', ...COMMON_FLAGS]);
  const spec = positional[0];
  if (!spec) { show({ ok: false, error: 'missing acceptance spec', usage: 'blender-cli accept <acceptance.json> --blend scene.blend [--receipt result.json]' }, ctx); process.exit(1); }
  const r = runAcceptance(spec, { blend: flags.blend, receipt: flags.receipt, flags });
  show(r, ctx); if (!r.ok) process.exit(1);
};

// --- Parametric verbs: add / keyframe / material ----------------------------
// The agent can always write bpy, but the same twenty lines of boilerplate get
// re-derived on every call and the active_object context trips it up (one
// operation between creation and finalize silently retargets the wrong mesh).
// These verbs address objects by NAME, run every op in one Blender launch, and
// report the resulting state, so a scene can be built without touching bpy.
const ADD_BODY = `import math as _m
from mathutils import Vector
sc = bpy.context.scene
def _vec(v, n=3):
    if v is None: return None
    if isinstance(v, str): v = [float(x) for x in v.split(",")]
    if isinstance(v, (int, float)): v = [float(v)]
    v = [float(x) for x in v]
    if len(v) == 1 and n == 3: v = v * 3
    if len(v) != n: raise RuntimeError("expected %d comma-separated numbers, got %r" % (n, v))
    return v
def _link(o):
    sc.collection.objects.link(o); return o
KINDS = ("cube", "sphere", "icosphere", "plane", "cylinder", "cone", "torus", "monkey", "camera", "light", "empty", "text")
created = []
for op in PARAMS["ops"]:
    what = str(op.get("what") or "").lower()
    if what not in KINDS: raise RuntimeError("unknown object kind: %r (use %s)" % (what, "|".join(KINDS)))
    name = op.get("name")
    at = _vec(op.get("at")) or [0.0, 0.0, 0.0]
    size_given = op.get("size")
    size = float(size_given) if size_given is not None else 2.0
    before = set(x.name for x in bpy.data.objects)
    o = None
    if what == "cube": bpy.ops.mesh.primitive_cube_add(size=size, location=at)
    elif what == "sphere": bpy.ops.mesh.primitive_uv_sphere_add(radius=size / 2, location=at)
    elif what == "icosphere": bpy.ops.mesh.primitive_ico_sphere_add(radius=size / 2, location=at)
    elif what == "plane": bpy.ops.mesh.primitive_plane_add(size=size, location=at)
    elif what == "cylinder": bpy.ops.mesh.primitive_cylinder_add(radius=size / 2, depth=size, location=at)
    elif what == "cone": bpy.ops.mesh.primitive_cone_add(radius1=size / 2, depth=size, location=at)
    elif what == "torus": bpy.ops.mesh.primitive_torus_add(major_radius=size / 2, minor_radius=size / 8, location=at)
    elif what == "monkey": bpy.ops.mesh.primitive_monkey_add(size=size, location=at)
    elif what == "camera":
        o = _link(bpy.data.objects.new(name or "Camera", bpy.data.cameras.new(name or "Camera")))
        if op.get("lens") is not None: o.data.lens = float(op["lens"])
        if sc.camera is None or op.get("active"): sc.camera = o
    elif what == "light":
        t = str(op.get("type") or "point").upper()
        if t not in ("POINT", "SUN", "SPOT", "AREA"): raise RuntimeError("light --type must be point|sun|spot|area")
        ld = bpy.data.lights.new(name or t.title(), type=t)
        if op.get("energy") is not None: ld.energy = float(op["energy"])
        col = _vec(op.get("color"))
        if col: ld.color = col
        o = _link(bpy.data.objects.new(name or t.title(), ld))
    elif what == "empty":
        o = _link(bpy.data.objects.new(name or "Empty", None))
    elif what == "text":
        cu = bpy.data.curves.new(name or "Text", type="FONT")
        cu.body = str(op.get("text") if op.get("text") is not None else "Text")
        cu.size = float(size_given) if size_given is not None else 1.0
        o = _link(bpy.data.objects.new(name or "Text", cu))
    if o is None:
        new = [x for x in bpy.data.objects if x.name not in before]
        o = new[0] if new else bpy.context.view_layer.objects.active
    o.location = at
    if name: o.name = name
    rot = _vec(op.get("rot"))
    if rot: o.rotation_euler = [_m.radians(v) for v in rot]
    scl = _vec(op.get("scale"))
    if scl: o.scale = scl
    la = _vec(op.get("look_at"))
    if la: o.rotation_euler = (Vector(la) - Vector(o.location)).to_track_quat("-Z", "Y").to_euler()
    bpy.context.view_layer.update()
    created.append({"name": o.name, "type": o.type, "kind": what, "location": [round(v, 4) for v in o.location],
        "rotation_deg": [round(_m.degrees(v), 2) for v in o.rotation_euler], "scale": [round(v, 4) for v in o.scale],
        "dimensions": [round(v, 4) for v in o.dimensions], "renamed": bool(name and o.name != name)})
result["added"] = created
result["objects"] = len(sc.objects)`;

const KEYFRAME_BODY = `${FCURVES_HELPER}import math as _m
sc = bpy.context.scene
ALIAS = {"location": "location", "loc": "location", "rotation": "rotation_euler", "rot": "rotation_euler",
    "rotation_euler": "rotation_euler", "scale": "scale"}
extend = PARAMS.get("extend", True)
keyed = []; touched = []
for op in PARAMS["ops"]:
    oname = op.get("object")
    o = bpy.data.objects.get(str(oname)) if oname else None
    if o is None:
        raise RuntimeError("no object named %r (objects: %s)" % (oname, ", ".join(sorted(x.name for x in bpy.data.objects)[:40]) or "none"))
    prop = str(op.get("prop") or "location")
    path = ALIAS.get(prop, prop)
    frame = int(op["frame"])
    # Dotted paths (data.energy, modifiers["Wave"].height) resolve to their
    # owner; the key is inserted relative to that owner.
    head, _, attr = path.rpartition(".")
    owner = o.path_resolve(head) if head else o
    val = op.get("value")
    if val is not None:
        if isinstance(val, str): val = [float(x) for x in val.split(",")]
        if isinstance(val, (int, float)): val = [float(val)]
        val = [float(v) for v in val]
        if path == "rotation_euler": val = [_m.radians(v) for v in val]
        try:
            cur = getattr(owner, attr)
        except AttributeError:
            raise RuntimeError("object %s has no property %r" % (o.name, path))
        if hasattr(cur, "__len__"):
            if len(val) == 1 and len(cur) > 1: val = val * len(cur)
            if len(val) != len(cur): raise RuntimeError("%s expects %d values, got %d" % (path, len(cur), len(val)))
            setattr(owner, attr, val)
        else:
            setattr(owner, attr, val[0])
    if not owner.keyframe_insert(data_path=attr, frame=frame):
        raise RuntimeError("keyframe_insert failed for %s.%s at frame %d" % (o.name, path, frame))
    interp = str(op.get("interp") or PARAMS.get("interp") or "").upper()
    if interp:
        if interp not in ("LINEAR", "BEZIER", "CONSTANT"): raise RuntimeError("--interp must be linear|bezier|constant")
        holder = owner if hasattr(owner, "animation_data") else o
        fc_path = attr if holder is owner and owner is not o else path
        for fc in _fcurves(holder):
            if fc.data_path == fc_path:
                for kp in fc.keyframe_points:
                    if abs(kp.co.x - frame) < 1e-6: kp.interpolation = interp
    if extend:
        if frame > sc.frame_end: sc.frame_end = frame; result["frame_end_extended"] = frame
        if frame < sc.frame_start: sc.frame_start = frame; result["frame_start_extended"] = frame
    if o.name not in touched: touched.append(o.name)
    cur = getattr(owner, attr)
    keyed.append({"object": o.name, "prop": path, "frame": frame,
        "value": [round(float(v), 4) for v in cur] if hasattr(cur, "__len__") else round(float(cur), 4)})
result["keyed"] = keyed
def _summary(o):
    s = _anim_summary(o)
    # Keys on a dotted path like data.energy live on the DATA block's action.
    d = getattr(o, "data", None)
    if d is not None and getattr(d, "animation_data", None) is not None:
        s["data"] = _anim_summary(d)
    return s
result["animation"] = {n: _summary(bpy.data.objects[n]) for n in touched}
result["frame_range"] = [sc.frame_start, sc.frame_end]`;

const MATERIAL_BODY = `o = bpy.data.objects.get(PARAMS["object"])
if o is None: raise RuntimeError("no object named %r (objects: %s)" % (PARAMS["object"], ", ".join(sorted(x.name for x in bpy.data.objects)[:40]) or "none"))
if o.type not in ("MESH", "CURVE", "FONT", "SURFACE", "META"): raise RuntimeError("object %s (%s) cannot carry a material" % (o.name, o.type))
mname = PARAMS.get("name")
mat = bpy.data.materials.get(mname) if mname else None
created = mat is None
if mat is None: mat = bpy.data.materials.new(mname or (o.name + "_mat"))
if mat.node_tree is None: mat.use_nodes = True
nt = mat.node_tree
bsdf = next((n for n in nt.nodes if n.type == "BSDF_PRINCIPLED"), None)
if bsdf is None:
    bsdf = nt.nodes.new("ShaderNodeBsdfPrincipled")
    out_node = next((n for n in nt.nodes if n.type == "OUTPUT_MATERIAL"), None) or nt.nodes.new("ShaderNodeOutputMaterial")
    nt.links.new(bsdf.outputs["BSDF"], out_node.inputs["Surface"])
# Socket names moved in 4.0 (Emission -> Emission Color); try the new name first.
def _set(names, value):
    for nm in names:
        s = bsdf.inputs.get(nm)
        if s is None: continue
        dv = s.default_value
        if hasattr(dv, "__len__"):
            v = list(value) if isinstance(value, (list, tuple)) else [float(value)] * 3
            if len(v) == 3 and len(dv) == 4: v = v + [1.0]
            if len(v) != len(dv): raise RuntimeError("%s expects %d values, got %d" % (nm, len(dv), len(v)))
            s.default_value = v
        else:
            s.default_value = float(value[0] if isinstance(value, (list, tuple)) else value)
        return nm
    raise RuntimeError("this Blender's Principled BSDF has no socket named " + " / ".join(names))
inputs = {}
if PARAMS.get("color") is not None:
    inputs["base_color"] = _set(["Base Color"], PARAMS["color"])
    mat.diffuse_color = (list(PARAMS["color"]) + [1.0])[:4]
if PARAMS.get("roughness") is not None: inputs["roughness"] = _set(["Roughness"], PARAMS["roughness"])
if PARAMS.get("metallic") is not None: inputs["metallic"] = _set(["Metallic"], PARAMS["metallic"])
if PARAMS.get("alpha") is not None: inputs["alpha"] = _set(["Alpha"], PARAMS["alpha"])
if PARAMS.get("emission") is not None:
    inputs["emission"] = _set(["Emission Color", "Emission"], PARAMS["emission"])
    es = bsdf.inputs.get("Emission Strength")
    if PARAMS.get("emission_strength") is None and es is not None and es.default_value == 0:
        inputs["emission_strength"] = _set(["Emission Strength"], 1.0)
if PARAMS.get("emission_strength") is not None: inputs["emission_strength"] = _set(["Emission Strength"], PARAMS["emission_strength"])
if len(o.data.materials): o.data.materials[0] = mat
else: o.data.materials.append(mat)
result["material"] = {"object": o.name, "name": mat.name, "created": created, "inputs": inputs,
    "slots": len(o.data.materials), "sockets": [s.name for s in bsdf.inputs][:14]}`;

const parseNums = (s) => String(s).split(',').map(x => Number(x.trim()));
function parseColor(s) {
  const str = String(s).trim();
  const hex = str.match(/^#?([0-9a-f]{6})$/i);
  if (hex) return [0, 2, 4].map(i => parseInt(hex[1].slice(i, i + 2), 16) / 255);
  const v = parseNums(str);
  if (v.length !== 3 || v.some(n => !Number.isFinite(n))) throw new Error(`invalid colour: ${s} (use r,g,b in 0..1 or #rrggbb)`);
  return v;
}
function parseJsonOps(raw, what) {
  if (raw === true) throw new Error(`missing value for --json (a JSON list of ${what} ops)`);
  let ops;
  try { ops = JSON.parse(String(raw)); } catch (e) { throw new Error(`--json is not valid JSON: ${e.message}`); }
  if (!Array.isArray(ops)) ops = [ops];
  if (!ops.length) throw new Error('--json list is empty');
  if (ops.some(o => !o || typeof o !== 'object')) throw new Error('--json entries must be objects');
  return ops;
}

commands.add = async (args, ctx) => {
  const { flags, positional } = fdn.parseArgs(args, ['blend', 'save', 'name', 'at', 'rot', 'size', 'scale', 'look-at', 'type', 'energy', 'color', 'text', 'lens', 'json', ...COMMON_FLAGS]);
  const usage = 'blender-cli add cube|sphere|icosphere|plane|cylinder|cone|torus|monkey|camera|light|empty|text [--name N] [--at x,y,z] [--rot x,y,z] [--size N] [--scale x,y,z] [--look-at x,y,z] [--type sun|point|spot|area] [--energy N] [--color r,g,b] [--text "..."] [--blend f] [--save f]   |   add --json \'[{"what":"cube","name":"A","at":[0,0,1]}, ...]\'';
  let ops;
  try {
    if (flags.json !== undefined) ops = parseJsonOps(flags.json, 'add');
    else {
      if (!positional[0]) throw new Error('missing object kind');
      ops = [{ what: positional[0], name: flags.name, at: flags.at, rot: flags.rot, size: flags.size, scale: flags.scale,
        look_at: flags['look-at'], type: flags.type, energy: flags.energy, text: flags.text, lens: flags.lens, active: !!flags.active,
        ...(flags.color !== undefined ? { color: flags.color } : {}) }];
    }
    for (const op of ops) if (typeof op.color === 'string') op.color = parseColor(op.color);
  } catch (e) { show({ ok: false, error: e.message, usage }, ctx); process.exit(1); }
  const r = runBlender(ADD_BODY, { blend: flags.blend, save: flags.save, params: { ops }, flags });
  show(r, ctx); if (!r.ok) process.exit(1);
};

commands.keyframe = async (args, ctx) => {
  const { flags, positional } = fdn.parseArgs(args, ['blend', 'save', 'prop', 'frame', 'value', 'interp', 'json', ...COMMON_FLAGS]);
  const usage = 'blender-cli keyframe <object> --frame N [--prop location|rotation|scale|<data.path>] [--value x,y,z] [--interp linear|bezier|constant] [--no-extend] [--blend f] [--save f]   |   keyframe --json \'[{"object":"Cube","prop":"location","frame":1,"value":[0,0,0]}, ...]\'';
  let ops;
  try {
    if (flags.json !== undefined) ops = parseJsonOps(flags.json, 'keyframe');
    else {
      if (!positional[0]) throw new Error('missing object name');
      if (flags.frame === undefined) throw new Error('missing --frame');
      ops = [{ object: positional[0], prop: flags.prop, frame: flags.frame, value: flags.value, interp: flags.interp }];
    }
    for (const op of ops) {
      if (!op.object) throw new Error('every keyframe needs an object name');
      if (op.frame === undefined || op.frame === true || !Number.isInteger(Number(op.frame))) throw new Error(`invalid frame: ${op.frame} (an integer)`);
    }
  } catch (e) { show({ ok: false, error: e.message, usage }, ctx); process.exit(1); }
  const params = { ops, extend: !flags['no-extend'], interp: typeof flags.interp === 'string' ? flags.interp : null };
  const r = runBlender(KEYFRAME_BODY, { blend: flags.blend, save: flags.save, params, flags });
  show(r, ctx); if (!r.ok) process.exit(1);
};

commands.material = async (args, ctx) => {
  const { flags, positional } = fdn.parseArgs(args, ['blend', 'save', 'name', 'color', 'roughness', 'metallic', 'alpha', 'emission', 'emission-strength', ...COMMON_FLAGS]);
  const usage = 'blender-cli material <object> [--name M] [--color r,g,b|#hex] [--roughness 0..1] [--metallic 0..1] [--alpha 0..1] [--emission r,g,b] [--emission-strength N] [--blend f] [--save f]';
  if (!positional[0]) { show({ ok: false, error: 'missing object name', usage }, ctx); process.exit(1); }
  const params = { object: positional[0], name: typeof flags.name === 'string' ? flags.name : null };
  try {
    if (flags.color !== undefined) params.color = parseColor(flags.color);
    if (flags.emission !== undefined) params.emission = parseColor(flags.emission);
    for (const [key, flag] of [['roughness', 'roughness'], ['metallic', 'metallic'], ['alpha', 'alpha'], ['emission_strength', 'emission-strength']]) {
      if (flags[flag] === undefined) continue;
      const n = Number(flags[flag]);
      if (flags[flag] === true || !Number.isFinite(n)) throw new Error(`invalid --${flag}: ${flags[flag]} (a number)`);
      params[key] = n;
    }
  } catch (e) { show({ ok: false, error: e.message, usage }, ctx); process.exit(1); }
  const r = runBlender(MATERIAL_BODY, { blend: flags.blend, save: flags.save, params, flags });
  show(r, ctx); if (!r.ok) process.exit(1);
};

// `blender-cli addon` — list / enable / disable / install add-ons and extensions
// headless. A pipeline that needs an importer add-on has no UI to turn it on;
// `enable` persists to user preferences by default (that is the point of it),
// `--no-persist` tries it for this call only. `install` takes a legacy add-on
// (.py or .zip) or an extension package (.zip with blender_manifest.toml, 4.2+).
const ADDON_LIST_BODY = `import addon_utils
show_all = bool(PARAMS.get("all"))
enabled = set(a.module for a in bpy.context.preferences.addons)
items = []
for m in addon_utils.modules(refresh=True):
    on = m.__name__ in enabled
    if not show_all and not on: continue
    info = addon_utils.module_bl_info(m)
    ver = info.get("version")
    items.append({"module": m.__name__, "name": info.get("name"), "version": ".".join(str(v) for v in ver) if ver else None,
        "category": info.get("category"), "enabled": on, "extension": m.__name__.startswith("bl_ext.")})
result["addons"] = items
result["enabled"] = len(enabled)
result["available"] = len(addon_utils.modules(refresh=False))
result["paths"] = list(addon_utils.paths())`;

const ADDON_TOGGLE_BODY = `import addon_utils
m = PARAMS["module"]
if PARAMS["action"] == "enable":
    if addon_utils.enable(m, default_set=True) is None:
        raise RuntimeError("could not enable add-on %r: not installed, or it failed to register (blender-cli addon list --all shows what is installed)" % m)
else:
    if m not in bpy.context.preferences.addons: raise RuntimeError("add-on %r is not enabled" % m)
    addon_utils.disable(m, default_set=True)
if PARAMS.get("persist"): bpy.ops.wm.save_userpref()
result["module"] = m
result["enabled"] = m in bpy.context.preferences.addons
result["persisted"] = bool(PARAMS.get("persist"))`;

const ADDON_INSTALL_BODY = `import addon_utils, zipfile
p = PARAMS["file"]
before = set(m.__name__ for m in addon_utils.modules(refresh=True))
is_ext = False
if p.lower().endswith(".zip"):
    with zipfile.ZipFile(p) as z:
        is_ext = any(n.split("/")[-1] == "blender_manifest.toml" and n.count("/") <= 1 for n in z.namelist())
if is_ext:
    if "package_install_files" not in dir(bpy.ops.extensions):
        raise RuntimeError("this file is a Blender extension (blender_manifest.toml) but this Blender has no extensions system (needs 4.2+)")
    bpy.ops.extensions.package_install_files(filepath=p, repo="user_default", enable_on_install=bool(PARAMS.get("enable")))
else:
    bpy.ops.preferences.addon_install(filepath=p, overwrite=True)
after = set(m.__name__ for m in addon_utils.modules(refresh=True))
new = sorted(after - before)
module = new[0] if len(new) == 1 else None
if module is None and not is_ext:
    stem = os.path.basename(p).rsplit(".", 1)[0]
    if stem in after: module = stem
result["installed"] = {"file": p, "kind": "extension" if is_ext else "addon", "modules_added": new, "module": module}
if PARAMS.get("enable") and not is_ext:
    if module is None: raise RuntimeError("installed, but could not tell which module to enable (candidates: %s)" % (", ".join(new) or "none"))
    if addon_utils.enable(module, default_set=True) is None: raise RuntimeError("installed %s but enabling it failed (see logs)" % module)
if PARAMS.get("enable") and PARAMS.get("persist"): bpy.ops.wm.save_userpref()
result["enabled"] = bool(module and module in bpy.context.preferences.addons)`;

commands.addon = async (args, ctx) => {
  const { flags, positional } = fdn.parseArgs(args, COMMON_FLAGS);
  const [sub, target] = positional;
  const usage = 'blender-cli addon list [--all] | enable <module> [--no-persist] | disable <module> [--no-persist] | install <file.py|.zip> [--enable] [--no-persist]';
  const persist = !flags['no-persist'];
  let r;
  if (sub === 'list') r = runBlender(ADDON_LIST_BODY, { params: { all: !!flags.all }, flags });
  else if (sub === 'enable' || sub === 'disable') {
    if (!target) { show({ ok: false, error: `missing module name for addon ${sub}`, usage }, ctx); process.exit(1); }
    r = runBlender(ADDON_TOGGLE_BODY, { params: { module: target, action: sub, persist }, flags });
  } else if (sub === 'install') {
    if (!target || !existsSync(target)) { show({ ok: false, error: `add-on file not found: ${target || '(none given)'}`, usage }, ctx); process.exit(1); }
    r = runBlender(ADDON_INSTALL_BODY, { params: { file: resolve(target), enable: !!flags.enable, persist }, flags });
  } else { show({ ok: false, error: `unknown addon subcommand: ${sub || '(none)'}`, usage }, ctx); process.exit(1); }
  show(r, ctx); if (!r.ok) process.exit(1);
};

// `blender-cli job` — the other half of --detach.
commands.job = async (args, ctx) => {
  const { flags, positional } = fdn.parseArgs(args, ['timeout', 'poll']);
  const [sub, id] = positional;
  const usage = 'blender-cli job list | status <id> | wait <id> [--timeout sec] [--poll sec] | cancel <id>';
  if (sub === 'list') {
    let ids = [];
    try { ids = readdirSync(JOBS_DIR).filter(d => existsSync(join(JOBS_DIR, d, 'job.json'))).sort().reverse(); } catch { /* no jobs yet */ }
    const jobs = ids.map(j => { const s = jobStatus(j); return { job: s.job, status: s.status, command: s.command, started: s.started, elapsed_s: s.elapsed_s, progress: s.progress, out: s.out }; });
    show({ ok: true, jobs, running: jobs.filter(j => j.status === 'running').length, dir: JOBS_DIR }, ctx);
    return;
  }
  if (sub === 'status') { const r = jobStatus(id); show(r, ctx); if (!r.ok) process.exit(1); return; }
  if (sub === 'wait') {
    if (!readJob(id)) { show({ ok: false, error: `unknown job: ${id || '(none given)'}`, hint: 'blender-cli job list' }, ctx); process.exit(1); }
    const limit = flags.timeout !== undefined ? Number(flags.timeout) : 0;
    if (flags.timeout !== undefined && !(limit > 0)) { show({ ok: false, error: `invalid --timeout: ${flags.timeout} (whole seconds)` }, ctx); process.exit(1); }
    const poll = Math.max(0.2, Number(flags.poll) || 2);
    const deadline = limit ? Date.now() + limit * 1000 : Infinity;
    let r = jobStatus(id);
    while (r.status === 'running' && Date.now() < deadline) {
      await new Promise(rs => setTimeout(rs, poll * 1000));
      r = jobStatus(id);
    }
    if (r.status === 'running') { r.ok = false; r.error = `still running after ${limit}s (left running; blender-cli job cancel ${id} stops it)`; }
    show(r, ctx); if (!r.ok) process.exit(1);
    return;
  }
  if (sub === 'cancel') {
    const before = jobStatus(id);
    if (!before.job) { show(before, ctx); process.exit(1); }
    if (before.status === 'running') {
      if (process.platform === 'win32') spawnSync('taskkill', ['/pid', String(before.pid), '/T', '/F'], { stdio: 'ignore' });
      else { try { process.kill(before.pid, 'SIGTERM'); } catch { /* raced with exit */ } }
    }
    const job = readJob(id);
    job.status = before.status === 'running' ? 'cancelled' : before.status;
    job.finished = job.finished || new Date().toISOString();
    writeJob(job);
    show({ ok: true, job: id, status: job.status, was: before.status }, ctx);
    return;
  }
  show({ ok: false, error: `unknown job subcommand: ${sub || '(none)'}`, usage }, ctx); process.exit(1);
};

// --- Machine-readable command manifest ---------------------------------------
// Agents and harnesses should not have to scrape --help. `schema` emits the
