function renderSkill(m) {
  const rows = m.commands.map(c => `| \`${c.usage}\` | ${c.effects.join(', ')} | ${c.summary} |`).join('\n');
  const legend = Object.entries(m.effects_legend).map(([k, v]) => `- **${k}**: ${v}`).join('\n');
  const common = m.contract.common_flags.map(f => `\`--${f.name}${f.value ? ' <' + f.value + '>' : ''}\``).join(', ');
  return `---
name: blender-cli
description: Drive a local Blender headless from the shell: scaffold, build, animate, verify, render and export 3D scenes with JSON in and JSON out. Use when a task needs Blender without a GUI, an MCP server or an add-on.
---

# blender-cli ${m.version}

Run \`blender-cli doctor\` first. Every command prints ONE JSON object on stdout and exits 1 exactly when \`ok\` is false; add \`-H\` to pretty-print. Nothing persists unless you pass \`--save\` (scene state) or an output path (\`render\`, \`export\`, \`snapshot\`).

## The loop

1. Build: \`new\`, \`import\`, \`add\`, \`material\`, \`keyframe\`, or \`exec\` for anything else bpy can do (gate it with \`--check\` / \`--safe\`).
2. Look: \`scene\` (state), \`verify\` (lint), \`snapshot\` (multi-view contact sheet with coverage stats).
3. Deliver: \`render\` (still or \`--animation\`; \`--detach\` then \`job wait\` for long ones), \`export\` (with a fidelity census).

## Commands

| usage | effects | what it does |
|---|---|---|
${rows}

## Effects

${legend}

Common flags on every Blender-running command: ${common}. Machine-readable version of this file: \`blender-cli schema\`.
`;
}

function buildManifest(specs = COMMAND_SPECS) {
  return {
    name: PKG.name, version: PKG.version, description: PKG.description,
    contract: {
      output: 'one JSON object on stdout per invocation; -H pretty-prints',
      exit_code: '1 exactly when ok is false',
      persistence: 'scene changes persist only with --save; render/export/snapshot/accept write to the path given',
      env: { BLENDER_BIN: 'Blender binary override', BLENDER_CLI_SAFE: '1 makes --safe the default', MESHY_API_KEY: 'text/image-to-3D backend' },
      common_flags: COMMON_SPEC_FLAGS,
    },
    effects_legend: EFFECTS,
    commands: specs,
  };
}

commands.install = (args, ctx) => {
  const { flags, positional } = fdn.parseArgs(args);
  const sub = positional[0] || 'all';
  if (!['codex', 'claude', 'all', 'doctor'].includes(sub)) {
    show({ ok: false, error: `unknown install target: ${sub}`, usage: 'blender-cli install codex|claude|all|doctor [--global]' }, ctx); process.exit(1);
  }
  const root = flags.global ? homedir() : process.cwd();
  const targets = {
    codex: join(root, flags.global ? '.codex' : '.agents', 'skills', 'blender-cli', 'SKILL.md'),
    claude: join(root, '.claude', 'skills', 'blender-cli', 'SKILL.md'),
  };
  const names = sub === 'all' || sub === 'doctor' ? ['codex', 'claude'] : [sub];
  const skill = renderSkill(buildManifest());
  const items = names.map(name => {
    const path = targets[name];
    const exists = existsSync(path);
    const current = exists ? readFileSync(path, 'utf8') : null;
    if (sub === 'doctor') return { target: name, path, installed: exists, current: current === skill };
    if (current === skill) return { target: name, path, installed: true, changed: false };
    try {
      mkdirSync(dirname(path), { recursive: true });
      writeFileSync(path, skill);
      return { target: name, path, installed: true, changed: true };
    } catch (e) {
      return { target: name, path, installed: false, changed: false, error: e.message };
    }
  });
  const ok = sub === 'doctor' ? items.every(i => i.installed && i.current) : items.every(i => i.installed);
  show({ ok, scope: flags.global ? 'global' : 'repository', items,
    ...(ok ? {} : { error: 'one or more agent skills are missing or stale', hint: `blender-cli install all${flags.global ? ' --global' : ''}` }) }, ctx);
  if (!ok) process.exit(1);
};

commands.schema = (args, ctx) => {
  const { flags } = fdn.parseArgs(args, ['out', 'command', 'effects']);
  let specs = COMMAND_SPECS;
  if (flags.command !== undefined) {
    if (flags.command === true) { show({ ok: false, error: 'missing value for --command' }, ctx); process.exit(1); }
    const names = String(flags.command).split(',').map(x => x.trim()).filter(Boolean);
    const unknown = names.filter(n => !COMMAND_SPECS.some(c => c.name === n));
    if (unknown.length) { show({ ok: false, error: `unknown command(s): ${unknown.join(', ')}` }, ctx); process.exit(1); }
    specs = specs.filter(c => names.includes(c.name));
  }
  if (flags.effects !== undefined) {
    if (flags.effects === true) { show({ ok: false, error: 'missing value for --effects' }, ctx); process.exit(1); }
    const effects = String(flags.effects).split(',').map(x => x.trim()).filter(Boolean);
    const unknown = effects.filter(e => !EFFECTS[e]);
    if (unknown.length) { show({ ok: false, error: `unknown effect(s): ${unknown.join(', ')}` }, ctx); process.exit(1); }
    specs = specs.filter(c => c.effects.some(e => effects.includes(e)));
  }
  const manifest = buildManifest(specs);
  if (flags.out === true) { show({ ok: false, error: 'missing value for --out' }, ctx); process.exit(1); }
  if (flags.skill && flags.compact) { show({ ok: false, error: '--compact emits JSON and cannot be combined with --skill' }, ctx); process.exit(1); }
  if (flags.skill) {
    const md = renderSkill(manifest);
    if (flags.out) { writeFileSync(resolve(flags.out), md); show({ ok: true, written: resolve(flags.out), bytes: Buffer.byteLength(md), format: 'skill' }, ctx); }
    else process.stdout.write(md);
    return;
  }
  const output = flags.compact ? { name: manifest.name, version: manifest.version,
    commands: specs.map(c => ({ name: c.name, effects: c.effects, usage: c.usage, flags: c.flags.map(f => f.name) })) } : manifest;
  if (flags.out) { writeFileSync(resolve(flags.out), JSON.stringify(output, null, 2) + '\n'); show({ ok: true, written: resolve(flags.out), commands: specs.length, format: 'json' }, ctx); return; }
  show(output, ctx);
};

