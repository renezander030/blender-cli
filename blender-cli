    process.exit(1);
  }
  const versionLine = (ver.stdout || '').split('\n')[0].trim();
  const probe = runBlender(`result["bpy_version"] = list(bpy.app.version)
result["build"] = bpy.app.version_string
result["python"] = sys.version.split()[0]
imp = dir(bpy.ops.wm); scn = dir(bpy.ops.import_scene); exp = dir(bpy.ops.export_scene)
impm = dir(bpy.ops.import_mesh); expm = dir(bpy.ops.export_mesh)
result["formats"] = {
    "gltf": "gltf" in scn, "fbx": "fbx" in scn,
    "obj": "obj_import" in imp or "obj" in scn,
    "stl": "stl_import" in imp or "stl" in dir(bpy.ops.import_mesh),
    "ply": "ply_import" in imp or "ply" in dir(bpy.ops.import_mesh),
    "usd": "usd_import" in imp, "alembic": "alembic_import" in imp, "collada": "collada_import" in imp}
result["io"] = {
    "gltf": {"import": "gltf" in scn, "export": "gltf" in exp},
    "fbx": {"import": "fbx" in scn, "export": "fbx" in exp},
    "obj": {"import": "obj_import" in imp or "obj" in scn, "export": "obj_export" in imp or "obj" in exp},
    "stl": {"import": "stl_import" in imp or "stl" in impm, "export": "stl_export" in imp or "stl" in expm},
    "ply": {"import": "ply_import" in imp or "ply" in impm, "export": "ply_export" in imp or "ply" in expm},
    "usd": {"import": "usd_import" in imp, "export": "usd_export" in imp},
    "alembic": {"import": "alembic_import" in imp, "export": "alembic_export" in imp},
    "collada": {"import": "collada_import" in imp, "export": "collada_export" in imp}}
result["video_ffmpeg"] = "FFMPEG" in [i.identifier for i in bpy.types.ImageFormatSettings.bl_rna.properties["file_format"].enum_items]
result["engines"] = [i.identifier for i in bpy.types.RenderSettings.bl_rna.properties["engine"].enum_items]
# Cycles denoises by default; a build without OpenImageDenoise fails the render
