#!/usr/bin/env node
// blender-cli — Drive Blender headless from your agent: scaffold, build, animate from natural language.
// Agent-first CLI: JSON output by default, -H/--human for a pretty-printed view.
// The CLI is a deterministic headless executor + inspector; your agent writes the bpy.
// Built on cli-foundation (see foundation.js for the primitives used here).

import * as fdn from './foundation.js';
import { spawnSync, spawn } from 'node:child_process';
import { writeFileSync, existsSync, readFileSync, readSync, mkdtempSync, readdirSync, mkdirSync, statSync, openSync, closeSync, renameSync, rmSync } from 'node:fs';
import { tmpdir, homedir } from 'node:os';
import { join, resolve, dirname, basename, sep } from 'node:path';
import { createHash } from 'node:crypto';

const DIR = fdn.dirOf(import.meta.url);
const env = fdn.loadEnv(`${DIR}/.env`);
const PKG = JSON.parse(readFileSync(join(DIR, 'package.json'), 'utf8'));

// Consistent output: terse JSON line by default, pretty JSON with -H/--human.
const show = (r, ctx) => fdn.emit(r, { human: ctx?.human, table: () => JSON.stringify(r, null, 2) });

function fileProof(path) {
  const p = resolve(path);
  if (!existsSync(p)) throw new Error(`artifact not found: ${p}`);
  const bytes = statSync(p).size;
  if (bytes <= 0) throw new Error(`artifact is empty: ${p}`);
  const hash = createHash('sha256');
  const fd = openSync(p, 'r');
  const chunk = Buffer.allocUnsafe(1024 * 1024);
  try {
    let read;
    while ((read = readSync(fd, chunk, 0, chunk.length, null)) > 0) hash.update(chunk.subarray(0, read));
  } finally { closeSync(fd); }
  return { path: p, bytes, sha256: hash.digest('hex') };
}

function writeJsonAtomic(path, value) {
  const p = resolve(path);
  mkdirSync(dirname(p), { recursive: true });
  const tmp = `${p}.tmp-${process.pid}-${Math.random().toString(36).slice(2, 8)}`;
  writeFileSync(tmp, JSON.stringify(value, null, 2) + '\n', { mode: 0o600 });
  renameSync(tmp, p);
  return p;
}

// Flags every Blender-running command accepts: --blender <path>, --timeout <sec>
// and --addons a,b (enable add-ons/extensions for this one call).
const COMMON_FLAGS = ['blender', 'timeout', 'addons'];

function parseAddons(flags) {
  if (flags.addons === undefined) return null;
  if (flags.addons === true || !String(flags.addons).trim()) return { error: 'missing value for --addons (comma-separated module names, no spaces)' };
  const list = String(flags.addons).split(',').map(s => s.trim()).filter(Boolean);
  if (!list.length || list.some(s => /\s/.test(s))) return { error: `invalid --addons value: ${flags.addons} (module names, comma-separated, no spaces)` };
  return { list };
}

// Version-aware F-curve access, prepended to every body that reads animation.
// Blender 4.4 introduced slotted actions and 5.0 removed the legacy
// Action.fcurves entirely, so the one-liner that worked on 4.3 raises
// AttributeError on 5.x. This reads whichever API the running build has.
const FCURVES_HELPER = `def _fcurves(o):
    ad = getattr(o, "animation_data", None)
    act = ad.action if ad else None
    if act is None: return []
    layers = getattr(act, "layers", None)
    if layers is not None and len(layers):
        out = []
        slot = getattr(ad, "action_slot", None)
        want = getattr(slot, "handle", None)
        for layer in layers:
            for strip in layer.strips:
                for cb in strip.channelbags:
                    have = getattr(cb, "slot_handle", None)
                    if want is None or have is None or have == want: out.extend(cb.fcurves)
        return out
    return list(getattr(act, "fcurves", None) or [])
def _anim_summary(o):
    fcs = _fcurves(o)
    frames = sorted(set(int(round(kp.co.x)) for fc in fcs for kp in fc.keyframe_points))
    return {"fcurves": len(fcs), "keyframes": sum(len(fc.keyframe_points) for fc in fcs),
        "frames": ([frames[0], frames[-1]] if frames else None)}
`;

// Known bpy API moves, keyed to the Blender version they landed in. exec --check
// reports the rows that apply to the build in use, and a failed exec appends the
// matching hints. The 5.x rows were verified against a real 5.1.1 build; the
// older ones come from Blender's release notes.
const API_DRIFT = [
  { id: 'action-fcurves', since: [5, 0], severity: 'error', pattern: '\\.action\\.fcurves\\b|\\bactions\\[[^\\]]*\\]\\.fcurves\\b',
    message: 'Action.fcurves is gone in 5.0+ (slotted actions since 4.4): F-curves live in action.layers[].strips[].channelbags[]',
    hint: 'iterate action.layers[0].strips[0].channelbag(obj.animation_data.action_slot).fcurves, or let blender-cli scene / keyframe read them' },
  { id: 'scene-node-tree', since: [5, 0], severity: 'error', pattern: '\\b(scene|sc|scn)\\.node_tree\\b',
    message: 'Scene.node_tree was removed in 5.0; the compositor tree is scene.compositing_node_group', hint: 'scene.compositing_node_group' },
  { id: 'use-nodes-assignment', since: [5, 0], severity: 'info', pattern: '\\.use_nodes\\s*=\\s*True',
    message: 'Material/World .use_nodes is deprecated in 5.x (removal planned for 6.0): node trees are always on', hint: 'drop the assignment and use .node_tree directly' },
  { id: 'import-scene-obj', since: [4, 0], severity: 'error', pattern: 'bpy\\.ops\\.(import|export)_scene\\.obj\\b',
    message: 'import_scene.obj / export_scene.obj were removed in 4.0', hint: 'bpy.ops.wm.obj_import(filepath=...) / bpy.ops.wm.obj_export(filepath=...)' },
  { id: 'import-mesh-stl-ply', since: [4, 2], severity: 'error', pattern: 'bpy\\.ops\\.(import|export)_mesh\\.(stl|ply)\\b',
    message: 'import_mesh.stl/ply and export_mesh.stl/ply are gone (the Python STL/PLY add-ons were removed in 4.2)', hint: 'bpy.ops.wm.stl_import / stl_export / ply_import / ply_export' },
  { id: 'eevee-next-id', since: [5, 0], severity: 'error', pattern: 'BLENDER_EEVEE_NEXT',
    message: 'BLENDER_EEVEE_NEXT is not an engine in 5.0+; EEVEE took the plain name back', hint: 'sc.render.engine = "BLENDER_EEVEE", or blender-cli render --engine eevee (resolved per build)' },
  { id: 'eevee-legacy-id', since: [4, 2], until: [5, 0], severity: 'error', pattern: '["\']BLENDER_EEVEE["\']',
    message: 'BLENDER_EEVEE is not an engine on 4.2-4.5 (it is BLENDER_EEVEE_NEXT there)', hint: 'BLENDER_EEVEE_NEXT, or blender-cli render --engine eevee' },
  { id: 'eevee-legacy-settings', since: [4, 2], severity: 'error', pattern: '\\.eevee\\.(use_ssr|use_gtao|use_bloom|use_ssr_refraction|use_soft_shadows)\\b',
    message: 'EEVEE Next (4.2+) dropped use_ssr / use_gtao / use_bloom / use_soft_shadows; reflections and AO are raytraced, bloom is a compositor Glare node', hint: 'sc.eevee.use_raytracing = True; bloom via the compositor Glare node' },
  { id: 'principled-4-renames', since: [4, 0], severity: 'error', pattern: '\\.inputs\\[["\'](Emission|Specular|Subsurface|Transmission|Clearcoat|Sheen)["\']\\]',
    message: 'Principled BSDF sockets were renamed in 4.0: Emission -> Emission Color, Specular -> Specular IOR Level, Subsurface -> Subsurface Weight, Transmission -> Transmission Weight, Clearcoat -> Coat Weight, Sheen -> Sheen Weight', hint: 'use the 4.0 socket names (blender-cli material does)' },
  { id: 'context-override-dict', since: [4, 0], severity: 'error', pattern: 'bpy\\.ops\\.\\w+\\.\\w+\\(\\s*\\{',
    message: 'passing a context dict to an operator was removed in 4.0', hint: 'with bpy.context.temp_override(**overrides): bpy.ops....()' },
  { id: 'object-select-attr', since: [2, 80], severity: 'error', pattern: '\\.select\\s*=\\s*(True|False)\\b',
    message: 'Object.select is gone since 2.80', hint: 'obj.select_set(True)' },
  { id: 'scene-objects-active', since: [2, 80], severity: 'error', pattern: '\\bscene\\.objects\\.active\\b',
    message: 'scene.objects.active is gone since 2.80', hint: 'bpy.context.view_layer.objects.active = obj' },
  { id: 'hemi-light', since: [2, 80], severity: 'error', pattern: 'type\\s*=\\s*["\']HEMI["\']',
    message: 'HEMI lights were removed in 2.80', hint: 'use a SUN light' },
  { id: 'rotation-data-path', severity: 'error', pattern: 'keyframe_insert\\(\\s*(data_path\\s*=\\s*)?["\']rotation["\']',
    message: '"rotation" is not an animatable data path', hint: 'keyframe_insert(data_path="rotation_euler", ...)' },
];

const versionAtLeast = (v, min) => (v[0] > min[0]) || (v[0] === min[0] && (v[1] ?? 0) >= (min[1] ?? 0));

// The drift rows that match this code on this Blender. With no version known,
// every matching row is returned and the reader judges.
function driftFor(code, version) {
  const out = [];
  for (const d of API_DRIFT) {
    if (!new RegExp(d.pattern, 'm').test(code)) continue;
    if (Array.isArray(version)) {
      if (d.since && !versionAtLeast(version, d.since)) continue;
      if (d.until && versionAtLeast(version, d.until)) continue;
    }
    out.push({ id: d.id, severity: d.severity, message: d.message, hint: d.hint,
      ...(d.since ? { since: d.since.join('.') } : {}), ...(d.until ? { until: d.until.join('.') } : {}) });
  }
  return out;
}

// --- Locate the Blender binary (cross-platform, overridable) -----------------
function platformCandidates() {
  const home = homedir();
  const mac = [
    '/Applications/Blender.app/Contents/MacOS/Blender',
    join(home, 'Applications/Blender.app/Contents/MacOS/Blender'),
  ];
  const linux = [
    '/usr/bin/blender', '/usr/local/bin/blender', '/snap/bin/blender',
    '/var/lib/flatpak/exports/bin/org.blender.Blender', join(home, '.local/bin/blender'),
  ];
  const win = [];
  if (process.platform === 'win32') {
    // Installer builds: Program Files\Blender Foundation\Blender X.Y\blender.exe (newest first).
    for (const pf of [process.env['ProgramFiles'], process.env['ProgramFiles(x86)']].filter(Boolean)) {
      const base = join(pf, 'Blender Foundation');
      try {
        for (const d of readdirSync(base).sort().reverse()) win.push(join(base, d, 'blender.exe'));
      } catch { /* not installed there */ }
    }
    // Steam puts Blender under steamapps; the Store build only exposes its
    // WindowsApps alias; scoop/choco shim into the user profile. All three are
    // common enough that "not found" on Windows is usually one of them.
    const pf86 = process.env['ProgramFiles(x86)'];
    if (pf86) win.push(join(pf86, 'Steam', 'steamapps', 'common', 'Blender', 'blender.exe'));
    if (process.env['LOCALAPPDATA']) win.push(join(process.env['LOCALAPPDATA'], 'Microsoft', 'WindowsApps', 'blender.exe'));
    if (process.env['USERPROFILE']) win.push(join(process.env['USERPROFILE'], 'scoop', 'apps', 'blender', 'current', 'blender.exe'));
    if (process.env['ChocolateyInstall']) win.push(join(process.env['ChocolateyInstall'], 'bin', 'blender.exe'));
    return win;
  }
  return process.platform === 'darwin' ? [...mac, ...linux] : [...linux, ...mac];
}

// An explicit pin (--blender / BLENDER_BIN) is used as-is: a typo'd pin must
// fail loudly, never silently fall through to a different Blender install.
function blenderBinInfo(flags = {}) {
  const pinned = flags.blender || env.BLENDER_BIN || process.env.BLENDER_BIN;
  if (pinned) return { bin: pinned, tried: [pinned] };
  const tried = platformCandidates();
  for (const c of tried) if (existsSync(c)) return { bin: c, tried };
  return { bin: 'blender', tried: [...tried, 'blender (PATH)'] }; // last resort: let PATH resolve it
}
const blenderBin = (flags) => blenderBinInfo(flags).bin;

// --- The deterministic boundary: run a bpy body headless, get JSON back -----
// The body goes to its own file and is exec()'d verbatim (no reindenting, so
// multi-line string literals survive untouched). The wrapper gives it PARAMS
// and `result`, captures print() output as `logs`, and emits ONE sentinel line
// with the JSON base64-armored: agent output can never collide with the
// delimiters, and NaN/Infinity floats are stringified instead of breaking parse.
const SENTINEL_A = '__BLENDER_CLI__';
const SENTINEL_B = '__END__';

// prepareBlender builds the wrapper script and the Blender argv; runBlender
// executes it synchronously and parses the sentinel; runBlenderDetached starts
// the same thing as a background job (see "Detached jobs" below).
function prepareBlender(body, { blend, save, params = {}, flags = {} } = {}) {
  const bin = blenderBin(flags);
  let timeoutMs = 0;
  if (flags.timeout !== undefined) {
    const t = Number(flags.timeout);
    if (flags.timeout === true || !Number.isFinite(t) || t <= 0) {
      return { ok: false, error: `invalid --timeout: ${flags.timeout} (whole seconds, e.g. --timeout 120)` };
    }
    timeoutMs = t * 1000;
  }
  const addons = parseAddons(flags);
  if (addons?.error) return { ok: false, error: addons.error };
  if (blend && !existsSync(blend)) return { ok: false, error: `blend not found: ${blend}` };
  let saveStage = null;
  if (save) {
    save = resolve(save);
    mkdirSync(dirname(save), { recursive: true });
    saveStage = join(dirname(save), `.blender-cli-save-${process.pid}-${Math.random().toString(36).slice(2)}.blend`);
    params.__save__ = save;
    params.__save_stage__ = saveStage;
    params.__save_before__ = existsSync(save) ? fileProof(save) : null;
  }
  const dir = mkdtempSync(join(tmpdir(), 'blender-cli-'));
  const script = join(dir, 'run.py');
  const bodyFile = join(dir, 'body.py');
  writeFileSync(bodyFile, body);
  if (addons) params.__addons__ = addons.list;
  params.__body__ = bodyFile;
  const wrapper = `import bpy, json, sys, os, time, traceback, io, contextlib, base64, math
def _clean(o):
    if isinstance(o, float) and not math.isfinite(o): return repr(o)
    if isinstance(o, dict): return {k: _clean(v) for k, v in o.items()}
    if isinstance(o, (list, tuple)): return [_clean(v) for v in o]
    return o
def emit(obj):
    try:
        s = json.dumps(obj, allow_nan=False)
    except ValueError:
        s = json.dumps(_clean(obj), allow_nan=False)
    sys.stdout.write("\\n${SENTINEL_A}" + base64.b64encode(s.encode("utf-8")).decode("ascii") + "${SENTINEL_B}\\n")
    sys.stdout.flush()
PARAMS = json.loads(${JSON.stringify(JSON.stringify(params))})
result = {}
_buf = io.StringIO(); _t0 = time.time()
def _finish(payload):
    logs = _buf.getvalue().strip()
    if logs: payload["logs"] = logs[-2000:]
    emit(payload)
try:
    # --addons: Blender's own flag enabled these before the file loaded, but it
    # only warns on stderr when a module is missing and carries on. Re-check
    # here and fail loudly instead, naming what IS installed.
    if PARAMS.get("__addons__"):
        import addon_utils
        _missing = []
        for _m in PARAMS["__addons__"]:
            if _m in bpy.context.preferences.addons: continue
            try: _ok = addon_utils.enable(_m, default_set=False) is not None
            except Exception: _ok = False
            if not _ok: _missing.append(_m)
        if _missing:
            _avail = sorted(m.__name__ for m in addon_utils.modules(refresh=False))
            raise RuntimeError("add-on(s) not available: " + ", ".join(_missing) + " (installed: " + ", ".join(_avail[:40]) + ("..." if len(_avail) > 40 else "") + "; see blender-cli addon list --all / addon install <file>)")
    with open(PARAMS["__body__"], encoding="utf-8") as _f:
        _code = compile(_f.read(), "<agent-bpy>", "exec")
    with contextlib.redirect_stdout(_buf):
        exec(_code, globals())
    if PARAMS.get("__save__"):
        import hashlib as _save_hash
        def _save_fingerprint(path):
            if not os.path.exists(path): return None
            h = _save_hash.sha256()
            with open(path, "rb") as f:
                for chunk in iter(lambda: f.read(1024 * 1024), b""): h.update(chunk)
            return {"bytes": os.path.getsize(path), "sha256": h.hexdigest()}
        dest = PARAMS["__save__"]; stage = PARAMS["__save_stage__"]
        before = PARAMS["__save_before__"]
        expected = {k: before[k] for k in ("bytes", "sha256")} if before else None
        bpy.ops.wm.save_as_mainfile(filepath=stage, check_existing=False)
        proof = _save_fingerprint(stage)
        if not proof or proof["bytes"] == 0: raise RuntimeError("scene save produced an empty file")
        if _save_fingerprint(dest) != expected:
            raise RuntimeError("save destination changed while Blender was running; reload and retry: " + dest)
        os.replace(stage, dest)
        result.setdefault("saved", PARAMS["__save__"])
        result["saved_artifact"] = {"path": dest, **proof}
    _finish({"ok": True, "result": result, "ms": int((time.time() - _t0) * 1000)})
except Exception as e:
    _p = {"ok": False, "error": str(e), "trace": traceback.format_exc(), "bpy_version": list(bpy.app.version)}
    if result: _p["result"] = result
    _finish(_p)
    sys.exit(1)
`;
  writeFileSync(script, wrapper);

  const args = ['--background'];
  if (addons) args.push('--addons', addons.list.join(','));
  if (blend) args.push(blend);
  args.push('--python', script, '--python-exit-code', '1');
  return { ok: true, bin, args, dir, timeoutMs, saveStage };
}

function parseSentinel(out) {
  const m = (out || '').match(new RegExp(SENTINEL_A + '([A-Za-z0-9+/=]+)' + SENTINEL_B));
  if (!m) return null;
  try { return JSON.parse(Buffer.from(m[1], 'base64').toString('utf8')); }
  catch { return { ok: false, error: 'bad JSON from Blender', raw: m[1].slice(0, 800) }; }
}

function newerBlendHint(blend, bin) {
  if (!blend || !existsSync(blend)) return null;
  let fd;
  try {
    const header = Buffer.alloc(12);
    fd = openSync(blend, 'r');
    if (readSync(fd, header, 0, 12, 0) !== 12 || header.toString('ascii', 0, 7) !== 'BLENDER') return null;
    const fileCode = Number(header.toString('ascii', 9, 12));
    if (!Number.isInteger(fileCode)) return null;
    const v = spawnSync(bin, ['--version'], { encoding: 'utf8', timeout: 5000, stdio: ['ignore', 'pipe', 'ignore'] });
    const m = String(v.stdout || '').match(/Blender\s+(\d+)\.(\d+)/i);
    if (!m || fileCode <= Number(m[1]) * 100 + Number(m[2])) return null;
    return { error: `scene was saved by Blender ${Math.floor(fileCode / 100)}.${fileCode % 100}; this binary is Blender ${m[1]}.${m[2]}. Open it with the same or a newer Blender, or set --blender to that binary.`,
      blend_file_version: `${Math.floor(fileCode / 100)}.${fileCode % 100}`, blender_version: `${m[1]}.${m[2]}` };
  } catch { return null; }
  finally { if (fd !== undefined) closeSync(fd); }
}

function runBlender(body, opts = {}) {
  const p = prepareBlender(body, opts);
  if (!p.ok) return { ok: false, error: p.error };
  // stdin is explicitly closed, never inherited. A Blender that inherits the
  // agent's stdin can block forever waiting on a pipe nobody writes to (the
  // classic Windows headless hang) — and --timeout would then be the only thing
  // ending the call. stdout/stderr stay piped: that's the result channel.
  try {
    const r = spawnSync(p.bin, p.args, {
      encoding: 'utf8', maxBuffer: 64 * 1024 * 1024,
      stdio: ['ignore', 'pipe', 'pipe'],
      ...(p.timeoutMs > 0 ? { timeout: p.timeoutMs, killSignal: 'SIGKILL' } : {}),
    });
    if (r.error && r.error.code === 'ETIMEDOUT') return { ok: false, error: `Blender timed out after ${p.timeoutMs / 1000}s (killed)`, timed_out: true, bin: p.bin };
    if (r.error) return { ok: false, error: `cannot run Blender (${p.bin}): ${r.error.message}`, bin: p.bin };
    const out = r.stdout || '';
    const parsed = parseSentinel(out);
    if (!parsed) return { ok: false, error: 'no result from Blender (script may have crashed before emit)',
      ...(newerBlendHint(opts.blend, p.bin) || {}), exit: r.status, stderr_tail: (r.stderr || '').slice(-800), stdout_tail: out.slice(-800), bin: p.bin };
    return parsed;
  } finally {
    rmSync(p.dir, { recursive: true, force: true });
    if (p.saveStage) for (const path of [p.saveStage, p.saveStage + '1', p.saveStage + '2']) rmSync(path, { force: true });
  }
}

// --- Detached jobs: start Blender, return at once, poll later ---------------
// A long animation render outlasts most agent tool-call limits (Claude Code
// kills a shell call after 2 minutes by default; MCP clients give up around 5).
// --detach spawns Blender unref'd with stdout/stderr going to a job directory,
// so the CLI returns a job id immediately; `job status` reads progress from
// Blender's own per-frame "Fra:" lines until the sentinel result appears.
const JOBS_DIR = env.BLENDER_CLI_JOBS_DIR || process.env.BLENDER_CLI_JOBS_DIR || join(homedir(), '.cache', 'blender-cli', 'jobs');
// The supervisor owns the deadline, so a detached Blender is stopped even if
// nobody calls `job status`. It also reaps its Blender process group on cancel.
const DETACHED_SUPERVISOR = String.raw`
const { spawn } = require('node:child_process');
const { rmSync } = require('node:fs');
const { bin, args, timeoutMs, scriptDir, saveStage } = JSON.parse(process.argv[1]);
const windows = process.platform === 'win32';
let child, finished = false;
const cleanup = () => {
  try { rmSync(scriptDir, { recursive: true, force: true }); } catch {}
  if (saveStage) for (const path of [saveStage, saveStage + '1', saveStage + '2']) {
    try { rmSync(path, { force: true }); } catch {}
  }
};
function stop() {
  if (!child || !child.pid) return;
  if (windows) {
    const killer = spawn('taskkill', ['/pid', String(child.pid), '/T', '/F'], { stdio: 'ignore' });
    killer.once('error', () => { try { child.kill('SIGKILL'); } catch {} });
  } else {
    try { process.kill(-child.pid, 'SIGKILL'); } catch { try { child.kill('SIGKILL'); } catch {} }
  }
}
const timer = timeoutMs > 0 ? setTimeout(() => {
  if (!finished) { process.stderr.write('__BCLI_TIMED_OUT__\n'); stop(); }
}, timeoutMs) : null;
process.on('SIGTERM', () => { process.stderr.write('__BCLI_CANCELLED__\n'); stop(); });
try { child = spawn(bin, args, { detached: !windows, stdio: ['ignore', 'inherit', 'inherit'] }); }
catch (e) { process.stderr.write(String(e.message) + '\n'); if (timer) clearTimeout(timer); cleanup(); process.exit(1); }
child.once('error', e => {
  process.stderr.write(String(e.message) + '\n');
  if (timer) clearTimeout(timer);
  cleanup(); process.exit(1);
});
child.once('exit', (code, signal) => {
  finished = true; if (timer) clearTimeout(timer); cleanup();
  process.exit(code == null ? (signal ? 128 : 1) : code);
});
`;
const jobDir = (id) => join(JOBS_DIR, id);
function readJob(id) {
  if (!id || /[\\/]/.test(id)) return null;
  const f = join(jobDir(id), 'job.json');
  if (!existsSync(f)) return null;
  try { return JSON.parse(readFileSync(f, 'utf8')); } catch { return null; }
}
function writeJob(job) {
  mkdirSync(jobDir(job.id), { recursive: true });
  writeFileSync(join(jobDir(job.id), 'job.json'), JSON.stringify(job, null, 2));
}
function pidAlive(pid) {
  if (!pid) return false;
  try { process.kill(pid, 0); return true; } catch (e) { return e.code === 'EPERM'; }
}
function runBlenderDetached(body, opts = {}, meta = {}) {
  const p = prepareBlender(body, opts);
  if (!p.ok) return { ok: false, error: p.error };
  const stamp = new Date().toISOString().replace(/[-:]/g, '').replace('T', '-').slice(0, 15);
  const id = `${stamp}-${Math.random().toString(36).slice(2, 6)}`;
  mkdirSync(jobDir(id), { recursive: true });
  const stdout = join(jobDir(id), 'stdout.log'), stderr = join(jobDir(id), 'stderr.log');
  const fo = openSync(stdout, 'a'), fe = openSync(stderr, 'a');
  let child;
  try {
    const config = JSON.stringify({ bin: p.bin, args: p.args, timeoutMs: p.timeoutMs, scriptDir: p.dir, saveStage: p.saveStage });
    child = spawn(process.execPath, ['-e', DETACHED_SUPERVISOR, config], { detached: true, stdio: ['ignore', fo, fe] });
  } catch (e) {
    closeSync(fo); closeSync(fe); rmSync(p.dir, { recursive: true, force: true });
    return { ok: false, error: `cannot start Blender (${p.bin}): ${e.message}` };
  }
  closeSync(fo); closeSync(fe);
  child.unref();
  const job = {
    id, pid: child.pid, command: meta.command || 'exec', started: new Date().toISOString(),
    bin: p.bin, blend: opts.blend || null, out: meta.out || null, frames: meta.frames || null,
    status: 'running', stdout, stderr, script_dir: p.dir,
    ...(p.timeoutMs > 0 ? { timeout_at: Date.now() + p.timeoutMs } : {}),
  };
  writeJob(job);
  return { ok: true, job: id, pid: child.pid, status: 'running', command: job.command, log: stdout,
    hint: `blender-cli job status ${id}   (or: blender-cli job wait ${id} --timeout 600)` };
}
function jobStatus(id) {
  const job = readJob(id);
  if (!job) return { ok: false, error: `unknown job: ${id || '(none given)'}`, hint: 'blender-cli job list' };
  const out = existsSync(job.stdout) ? readFileSync(job.stdout, 'utf8') : '';
  const result = parseSentinel(out);
  const err = existsSync(job.stderr) ? readFileSync(job.stderr, 'utf8') : '';
  let status;
  if (result) status = result.ok ? 'done' : 'failed';
  else if (job.status === 'cancelled') status = 'cancelled';
  else if (err.includes('__BCLI_TIMED_OUT__')) status = 'timed_out';
  else if (!job.script_dir && job.timeout_at && Date.now() > job.timeout_at && pidAlive(job.pid)) {
    try { process.kill(job.pid, 'SIGKILL'); } catch { /* already gone */ }
    status = 'timed_out';
  }
  else if (!pidAlive(job.pid)) status = job.status === 'timed_out' ? 'timed_out' : 'failed';
  else status = 'running';
  if (status !== 'running' && job.script_dir) {
    try { rmSync(job.script_dir, { recursive: true, force: true }); } catch { /* a Windows process may still hold it briefly */ }
  }
  if (status !== job.status) { job.status = status; if (status !== 'running') job.finished = job.finished || new Date().toISOString(); writeJob(job); }
  // Progress from Blender's own console: Cycles prints "Fra:12 Mem:..." per
  // frame, every engine prints "Saved: '...'" per written image, and video
  // encoding prints "Append frame 12". 5.x prefixes each line with a timestamp
  // and a category ("00:02.326  render | Saved: ..."), so anchor after the bar too.
  const fra = new Set(), appended = new Set();
  for (const m of out.matchAll(/(?:^|\|\s*)Fra:(\d+)/gm)) fra.add(Number(m[1]));
  for (const m of out.matchAll(/(?:^|\|\s*)Append frame (\d+)/gm)) appended.add(Number(m[1]));
  const saved = (out.match(/(?:^|\|\s*)Saved: /gm) || []).length;
  const done = Math.max(fra.size, appended.size, saved);
  const total = Array.isArray(job.frames) ? job.frames[1] - job.frames[0] + 1 : null;
  const progress = { frames_done: done, ...(total ? { frames_total: total, percent: Math.min(100, Math.round(100 * done / total)) } : {}) };
  const lines = out.split('\n').filter(l => l.trim() && !l.includes(SENTINEL_A));
  const end = job.finished ? Date.parse(job.finished) : Date.now();
  const r = {
    ok: !['failed', 'timed_out'].includes(status), job: id, status, command: job.command, pid: job.pid,
    started: job.started, elapsed_s: Math.max(0, Math.round((end - Date.parse(job.started)) / 1000)),
    progress, out: job.out, log: job.stdout,
  };
  if (result) {
    r.result = result.result ?? null;
    if (result.error) r.error = result.error;
    if (result.logs) r.logs = result.logs;
    if (result.ms) r.ms = result.ms;
  } else if (status === 'running') r.last_line = lines[lines.length - 1] || null;
  else if (status === 'failed') { r.error = 'Blender exited without a result'; r.stderr_tail = (existsSync(job.stderr) ? readFileSync(job.stderr, 'utf8') : '').slice(-800); r.stdout_tail = out.slice(-400); }
  else if (status === 'timed_out') r.error = 'job exceeded --timeout and was killed';
  return r;
}

// --- Asset backends: Poly Haven download + Meshy text-to-3D (Node >=18 fetch) --
// Downloads land in ~/.cache/blender-cli/ and are skipped when the file already
// exists with the expected size, so repeat imports cost zero bytes.
async function downloadTo(url, dest, expectedSize = null, { force = false } = {}) {
  if (!force && existsSync(dest) && (expectedSize == null || statSync(dest).size === Number(expectedSize))) return { cached: true };
  const r = await fetch(url);
  if (!r.ok) throw new Error(`download failed (${r.status}): ${url}`);
  const buf = Buffer.from(await r.arrayBuffer());
  if (!buf.length) throw new Error(`download was empty: ${url}`);
  if (expectedSize != null && buf.length !== Number(expectedSize)) {
    throw new Error(`download size mismatch for ${url}: expected ${expectedSize} bytes, got ${buf.length}`);
  }
  mkdirSync(dirname(dest), { recursive: true });
  const tmp = `${dest}.tmp-${process.pid}-${Math.random().toString(36).slice(2, 8)}`;
  try { writeFileSync(tmp, buf); renameSync(tmp, dest); }
  finally { rmSync(tmp, { force: true }); }
  return { cached: false, bytes: buf.length };
}

async function fetchJson(url, headers = {}) {
  const r = await fetch(url, { headers });
  if (!r.ok) throw new Error(`HTTP ${r.status}`);
  return r.json();
}

function exportBundleProof(result) {
  const exported = result?.exported;
  if (!exported) return;
  const main = fileProof(exported.file);
  const members = [{ uri: basename(main.path), ...main }];
  if (exported.format === 'gltf') {
    const data = JSON.parse(readFileSync(main.path, 'utf8'));
    const uris = new Set([...(data.buffers || []), ...(data.images || [])].map(x => x.uri).filter(Boolean));
    for (const uri of [...uris].sort()) {
      if (uri.startsWith('data:')) continue;
      if (/^[a-z][a-z0-9+.-]*:/i.test(uri) || uri.startsWith('//')) throw new Error(`cannot verify remote glTF dependency: ${uri}`);
      const path = resolve(dirname(main.path), decodeURIComponent(uri));
      members.push({ uri, ...fileProof(path) });
    }
  }
  exported.artifacts = members;
  exported.bundle_sha256 = createHash('sha256').update(JSON.stringify(members.map(({ uri, bytes, sha256 }) => ({ uri, bytes, sha256 })))).digest('hex');
}

function checkReceipt(path) {
  const value = JSON.parse(readFileSync(resolve(path), 'utf8'));
  if (value.schema_version !== 1 || value.tool !== PKG.name || value.passed !== true || value.acceptance?.passed !== true) {
    throw new Error('receipt is unsupported, incomplete or records a failed acceptance');
  }
  const checks = [];
  for (const key of ['spec', 'source', 'snapshot']) {
    const expected = value[key];
    if (key === 'snapshot' && expected === null) continue;
    if (!expected || typeof expected.path !== 'string' || !Number.isInteger(expected.bytes) || expected.bytes <= 0 || !/^[a-f0-9]{64}$/.test(expected.sha256)) {
      throw new Error(`invalid receipt artifact: ${key}`);
    }
    try {
      const actual = fileProof(expected.path);
      checks.push({ artifact: key, path: actual.path, matched: actual.bytes === expected.bytes && actual.sha256 === expected.sha256 });
    } catch (e) { checks.push({ artifact: key, path: expected.path, matched: false, error: e.message }); }
  }
  return { ok: checks.every(x => x.matched), receipt: resolve(path), checks,
    ...(checks.some(x => !x.matched) ? { error: 'acceptance receipt artifacts changed or are missing' } : {}) };
}

const SOURCE_DEPENDENCIES = `result["source_dependencies"] = sorted(set(
    bpy.path.abspath(x.filepath, library=getattr(x, "library", None))
    for x in list(bpy.data.images) + list(bpy.data.libraries)
    if getattr(x, "filepath", "") and not getattr(x, "packed_file", None)
    and (not isinstance(x, bpy.types.Image) or x.source == "FILE")))
result["resume_supported"] = not any(i.source in ("SEQUENCE", "TILED", "MOVIE") for i in bpy.data.images)
`;

function matchingProof(expected) {
  try { const actual = fileProof(expected.path); return actual.bytes === expected.bytes && actual.sha256 === expected.sha256; }
  catch { return false; }
}

function resultArtifacts(result) {
  const artifacts = result?.exported?.artifacts || result?.artifact?.members || (result?.artifact ? [result.artifact] : []);
  if (!artifacts.length) throw new Error('result has no verifiable output artifacts');
  return artifacts.map(a => fileProof(a.path));
}

const PH_TYPE_NAMES = { 0: 'hdri', 1: 'texture', 2: 'model' };
const PH_NON_MAP_KEYS = new Set(['blend', 'gltf', 'usd', 'fbx', 'mtlx']);
const PH_MAP_ALIASES = {
  diffuse: ['diffuse', 'diff', 'albedo'], color: ['diffuse', 'diff', 'albedo'],
  roughness: ['roughness', 'rough'], rough: ['roughness', 'rough'],
  normal: ['normal', 'nor_gl', 'nor_dx'], metallic: ['metallic', 'metal'], metal: ['metallic', 'metal'],
  displacement: ['displacement', 'disp'], height: ['displacement', 'disp'], opacity: ['opacity', 'alpha'],
};

async function polyhavenDownload(assetId, { type, res, maps = null }) {
  if (type && !['hdri', 'texture', 'model'].includes(type)) throw new Error(`invalid --type: ${type} (use hdri|texture|model)`);
  let info;
  try { info = await fetchJson(`https://api.polyhaven.com/info/${assetId}`); }
  catch (e) { throw new Error(`polyhaven info ${assetId}: ${e.message} (unknown asset id?)`); }
  let files;
  try { files = await fetchJson(`https://api.polyhaven.com/files/${assetId}`); }
  catch (e) { throw new Error(`polyhaven files ${assetId}: ${e.message}`); }
  const kind = type || PH_TYPE_NAMES[info.type] || 'texture';
  const outDir = join(homedir(), '.cache', 'blender-cli', 'polyhaven', assetId, res);
  const wanted = maps?.length ? maps.map(x => x.toLowerCase())
    : ['diffuse', 'roughness', 'metallic', 'normal', 'displacement', 'opacity'];
  const dl = { kind, files: [], cached: 0, cache_dir: outDir,
    provenance: { provider: 'Poly Haven', source_url: `https://polyhaven.com/a/${assetId}`, license: 'CC0' } };
  const grab = async (url, dest, size) => {
    const d = await downloadTo(url, dest, size ?? null);
    if (d.cached) dl.cached++;
    dl.files.push(dest);
    return dest;
  };
  if (kind === 'hdri') {
    const atRes = files.hdri?.[res];
    if (!atRes) throw new Error(`no hdri at resolution ${res} for ${assetId} (available: ${Object.keys(files.hdri || {}).join(', ') || 'none'})`);
    const fmt = atRes.hdr || atRes.exr;
    if (!fmt) throw new Error(`no hdr/exr file for ${assetId}@${res}`);
    dl.main = await grab(fmt.url, join(outDir, basename(new URL(fmt.url).pathname)), fmt.size);
  } else if (kind === 'model') {
    const main = files.gltf?.[res]?.gltf;
    if (!main) throw new Error(`no gltf package at resolution ${res} for ${assetId} (available: ${Object.keys(files.gltf || {}).join(', ') || 'none'})`);
    dl.main = await grab(main.url, join(outDir, basename(new URL(main.url).pathname)), main.size);
    const root = resolve(outDir);
    for (const [rel, f] of Object.entries(main.include || {})) {
      const dest = resolve(join(outDir, rel));
      if (dest !== root && !dest.startsWith(root + sep)) throw new Error(`refusing include path outside cache dir: ${rel}`);
      await grab(f.url, dest, f.size);
    }
  } else {
    const maps = {};
    for (const [mapName, byRes] of Object.entries(files)) {
      if (PH_NON_MAP_KEYS.has(mapName)) continue;
      const mn = mapName.toLowerCase();
      if (wanted && !wanted.some(w => [w, ...(PH_MAP_ALIASES[w] || [])].some(a => mn === a || mn.startsWith(a) || mn.includes(a)))) continue;
      if (!maps?.length && mn.includes('nor_dx') && Object.keys(files).some(k => k.toLowerCase().includes('nor_gl'))) continue;
      const fmt = byRes?.[res] && (byRes[res].jpg || byRes[res].png || byRes[res].exr);
      if (!fmt) continue;
      maps[mapName] = await grab(fmt.url, join(outDir, basename(new URL(fmt.url).pathname)), fmt.size);
    }
    if (!Object.keys(maps).length) throw new Error(`no texture maps at resolution ${res} for ${assetId}`);
    dl.maps = maps;
  }
  return dl;
}

// Import-by-extension body shared by `import`, `import polyhaven:<model>`, and
// `generate --import`. Reads PARAMS["file"].
const IMPORT_BODY = `p = PARAMS["file"]; ext = p.lower().rsplit(".", 1)[-1]
before = set(o.name for o in bpy.data.objects)
wm = dir(bpy.ops.wm)
if ext in ("glb", "gltf"): bpy.ops.import_scene.gltf(filepath=p)
elif ext == "obj": (bpy.ops.wm.obj_import(filepath=p) if "obj_import" in wm else bpy.ops.import_scene.obj(filepath=p))
elif ext == "fbx": bpy.ops.import_scene.fbx(filepath=p)
elif ext == "stl": (bpy.ops.wm.stl_import(filepath=p) if "stl_import" in wm else bpy.ops.import_mesh.stl(filepath=p))
elif ext == "ply": (bpy.ops.wm.ply_import(filepath=p) if "ply_import" in wm else bpy.ops.import_mesh.ply(filepath=p))
elif ext in ("usd", "usda", "usdc", "usdz"): bpy.ops.wm.usd_import(filepath=p)
elif ext == "abc": bpy.ops.wm.alembic_import(filepath=p)
elif ext == "dae": bpy.ops.wm.collada_import(filepath=p)
else: raise RuntimeError("unsupported format: ." + ext + " (glb gltf obj fbx stl ply usd usda usdc usdz abc dae)")
added = [o for o in bpy.data.objects if o.name not in before]
if PARAMS.get("pack"): bpy.ops.file.pack_all()
result["imported"] = {"file": p, "format": ext, "objects": [{"name": o.name, "type": o.type} for o in added],
    "count": len(added), "verts": sum(len(o.data.vertices) for o in added if o.type == "MESH"), "packed": bool(PARAMS.get("pack"))}`;

// Batch import gathers many files into ONE scene, so it has to run inside a
// single Blender session — separate processes would each start empty and the
// last one would be all you kept. A file that fails to import is recorded and
// the rest still land.
const MULTI_IMPORT_BODY = `wm = dir(bpy.ops.wm)
def _imp(p):
    ext = p.lower().rsplit(".", 1)[-1]
    if ext in ("glb", "gltf"): bpy.ops.import_scene.gltf(filepath=p)
    elif ext == "obj": (bpy.ops.wm.obj_import(filepath=p) if "obj_import" in wm else bpy.ops.import_scene.obj(filepath=p))
    elif ext == "fbx": bpy.ops.import_scene.fbx(filepath=p)
    elif ext == "stl": (bpy.ops.wm.stl_import(filepath=p) if "stl_import" in wm else bpy.ops.import_mesh.stl(filepath=p))
    elif ext == "ply": (bpy.ops.wm.ply_import(filepath=p) if "ply_import" in wm else bpy.ops.import_mesh.ply(filepath=p))
    elif ext in ("usd", "usda", "usdc", "usdz"): bpy.ops.wm.usd_import(filepath=p)
    elif ext == "abc": bpy.ops.wm.alembic_import(filepath=p)
    elif ext == "dae": bpy.ops.wm.collada_import(filepath=p)
    else: raise RuntimeError("unsupported format: ." + ext)
    return ext
items = []
for p in PARAMS["files"]:
    before = set(o.name for o in bpy.data.objects)
    try:
        ext = _imp(p)
        added = [o for o in bpy.data.objects if o.name not in before]
        items.append({"file": p, "ok": True, "format": ext, "count": len(added),
            "objects": [o.name for o in added],
            "verts": sum(len(o.data.vertices) for o in added if o.type == "MESH" and o.data)})
    except Exception as e:
        partial = [o for o in bpy.data.objects if o.name not in before]
        for o in partial: bpy.data.objects.remove(o, do_unlink=True)
        items.append({"file": p, "ok": False, "error": str(e), "rolled_back_objects": len(partial)})
_failed = [i for i in items if not i["ok"]]
result["imported_batch"] = {"total": len(items), "succeeded": len(items) - len(_failed),
    "failed": len(_failed), "objects": sum(i.get("count", 0) for i in items), "items": items}`;

// HDRI → world environment; texture maps → a wired Principled BSDF material.
const HDRI_IMPORT_BODY = `w = bpy.data.worlds.get("World") or bpy.data.worlds.new("World")
bpy.context.scene.world = w
w.use_nodes = True
nt = w.node_tree
nt.nodes.clear()
bg = nt.nodes.new("ShaderNodeBackground")
env_node = nt.nodes.new("ShaderNodeTexEnvironment")
env_node.image = bpy.data.images.load(PARAMS["path"])
if PARAMS.get("pack"): env_node.image.pack()
out_node = nt.nodes.new("ShaderNodeOutputWorld")
nt.links.new(env_node.outputs["Color"], bg.inputs["Color"])
nt.links.new(bg.outputs["Background"], out_node.inputs["Surface"])
result["world"] = w.name
result["hdri_image"] = PARAMS["path"]
result["packed"] = bool(PARAMS.get("pack"))`;

const TEXTURE_IMPORT_BODY = `mat = bpy.data.materials.new(PARAMS["material_name"])
mat.use_nodes = True
nt = mat.node_tree
bsdf = nt.nodes.get("Principled BSDF")
out = next((n for n in nt.nodes if n.type == "OUTPUT_MATERIAL"), None)
connected = []; unused = []
for map_name, path in PARAMS["maps"].items():
    key = map_name.lower()
    target = ("Base Color" if any(x in key for x in ("diff", "albedo", "color")) else
        "Roughness" if "rough" in key else "Metallic" if "metal" in key else
        "Normal" if ("nor_gl" in key or key == "normal") else
        "Displacement" if any(x in key for x in ("disp", "height")) else
        "Alpha" if any(x in key for x in ("opacity", "alpha")) else None)
    tex = nt.nodes.new("ShaderNodeTexImage")
    tex.image = bpy.data.images.load(path)
    if PARAMS.get("pack"): tex.image.pack()
    cs = "sRGB" if target == "Base Color" else "Non-Color"
    try: tex.image.colorspace_settings.name = cs
    except Exception: pass
    if target and bsdf and (target != "Displacement" or out):
        if target == "Displacement" and out:
            disp = nt.nodes.new("ShaderNodeDisplacement")
            disp.inputs["Scale"].default_value = 0.1
            nt.links.new(tex.outputs["Color"], disp.inputs["Height"])
            nt.links.new(disp.outputs["Displacement"], out.inputs["Displacement"])
        elif target == "Normal":
            nm = nt.nodes.new("ShaderNodeNormalMap")
            nt.links.new(tex.outputs["Color"], nm.inputs["Color"])
            nt.links.new(nm.outputs["Normal"], bsdf.inputs["Normal"])
        else:
            nt.links.new(tex.outputs["Color"], bsdf.inputs[target])
        connected.append(map_name)
    else: unused.append(map_name)
result["material"] = mat.name
result["maps_added"] = list(PARAMS["maps"])
result["maps_connected"] = connected
result["maps_unused"] = unused
result["packed"] = bool(PARAMS.get("pack"))`;

// --safe gate: AST-validate agent code inside Blender, refuse on violations,
// then exec in a CLEAN namespace (bpy/PARAMS/result only) so wrapper imports
// like os/sys never leak in. Best-effort static gate, not a jail.
const SAFE_EXEC_BODY = `import ast
_src = PARAMS["__code__"]
violations = []
tree = None
try:
    tree = ast.parse(_src)
except SyntaxError as e:
    violations.append("syntax error: %s" % e)
BANNED_IMPORTS = {"os", "subprocess", "socket", "shutil", "sys", "ctypes", "urllib", "http"}
BANNED_CALLS = {"eval", "exec", "compile", "globals", "locals", "vars", "setattr", "delattr", "__import__"}
BANNED_ATTRS = {"system", "popen", "spawnl", "spawnv", "spawnve", "fork", "execl", "execv", "execve", "execvp",
    "startfile", "rmtree", "write_text", "write_bytes", "chmod", "symlink_to", "hardlink_to", "removedirs",
    "script_directories", "save_userpref", "__dict__", "__class__", "__subclasses__"}
def _mode_is_write(call, mode_idx):
    for kw in call.keywords:
        if kw.arg == "mode" and isinstance(kw.value, ast.Constant) and isinstance(kw.value.value, str):
            return any(c in kw.value.value for c in "wax+")
    if len(call.args) > mode_idx:
        a = call.args[mode_idx]
        if isinstance(a, ast.Constant) and isinstance(a.value, str):
            return any(c in a.value for c in "wax+")
    return False
if tree is not None:
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            for n in node.names:
                if n.name.split(".")[0] in BANNED_IMPORTS: violations.append("import of banned module: " + n.name)
        elif isinstance(node, ast.ImportFrom):
            if (node.module or "").split(".")[0] in BANNED_IMPORTS: violations.append("import-from banned module: " + str(node.module))
        elif isinstance(node, ast.Call):
            f = node.func
            fname = f.id if isinstance(f, ast.Name) else (f.attr if isinstance(f, ast.Attribute) else None)
            if fname in BANNED_CALLS: violations.append("call to banned builtin: " + fname)
            if fname == "open" and _mode_is_write(node, 1 if isinstance(f, ast.Name) else 0):
                violations.append("open()/.open() call in write/append mode")
            if fname == "getattr" and node.args and isinstance(node.args[0], ast.Name) and node.args[0].id in BANNED_IMPORTS:
                violations.append("getattr() escape via banned module: " + node.args[0].id)
            if fname == "getattr" and len(node.args) > 1 and isinstance(node.args[1], ast.Constant) and node.args[1].value in BANNED_ATTRS:
                violations.append("getattr() access to blocked persistence/reflection surface: " + str(node.args[1].value))
            if fname in BANNED_ATTRS and isinstance(f, ast.Attribute):
                violations.append("attribute access looks like a system/filesystem escape: ." + fname)
        elif isinstance(node, ast.Attribute) and node.attr in BANNED_ATTRS:
            violations.append("blocked persistence/reflection attribute: ." + node.attr)
if violations:
    result["violations"] = sorted(set(violations))
    raise RuntimeError("sandbox: rejected %d violation(s)" % len(set(violations)))
if PARAMS.get("__validate_only__"):
    result["safe_gate"] = "pass"
else:
    _ns = {"bpy": bpy, "PARAMS": PARAMS, "result": result, "math": math, "json": json, "time": time, "__builtins__": __builtins__}
    exec(compile(tree, "<agent-bpy>", "exec"), _ns)
    _r = _ns.get("result")
    if _r is not result:
        if isinstance(_r, dict): result.update(_r)
        else: result["value"] = _r`;

// --- Batch: one verb over many files ----------------------------------------
// Deliberately a tiny matcher, not a glob library: `*` and `?` in the LAST path
// segment only, no `**`. Quote the pattern so it reaches us unexpanded — an
// unquoted glob is expanded by the shell before the CLI ever sees it.
function globFiles(pattern) {
  const abs = resolve(pattern);
  const dir = dirname(abs);
  const pat = basename(abs);
  if (!/[*?]/.test(pat)) return existsSync(abs) ? [abs] : [];
  const rx = new RegExp('^' + pat.replace(/[.+^${}()|[\]\\]/g, '\\$&').replace(/\*/g, '.*').replace(/\?/g, '.') + '$');
  let entries;
  try { entries = readdirSync(dir); } catch { return []; }
  return entries.filter(f => rx.test(f)).sort().map(f => join(dir, f));
}

// Every item runs; a failure is recorded against its file and the run continues.
// One unreadable .blend in a folder of forty should cost you that one render,
// not the batch — so the exit code reports the whole outcome at the end.
async function batchRun(files, fn, { manifest, resume = false, signature = null } = {}) {
  let ledger = { schema_version: 1, tool: PKG.name, tool_version: PKG.version, signature, items: {} };
  if (resume && !manifest) throw new Error('--resume requires --manifest <path>');
  if (manifest && files.some(f => resolve(f) === resolve(manifest))) throw new Error('batch manifest must not overwrite a source file');
  if (manifest && existsSync(manifest)) {
    const old = JSON.parse(readFileSync(manifest, 'utf8'));
    if (old.schema_version !== 1 || old.tool !== PKG.name || !old.items || typeof old.items !== 'object') throw new Error('unsupported batch manifest');
    if (resume && old.tool_version === PKG.version && old.signature === signature) ledger = old;
  }
  const items = [];
  for (const f of files) {
    let r;
    let source;
    try {
      source = fileProof(f);
      const old = ledger.items[f];
      if (resume && old?.ok && old.resume_supported !== false && matchingProof(old.source) &&
          old.artifacts?.length && old.artifacts.every(matchingProof) && old.dependencies?.every(matchingProof) &&
          (!old.receipt || checkReceipt(old.receipt).ok)) {
        items.push({ file: f, ok: true, skipped: true, result: old.result });
        continue;
      }
      r = await fn(f);
      if (r.ok && !matchingProof(source)) { r.ok = false; r.error = 'source scene changed during the batch item; retry with the current scene'; }
      if (r.ok && manifest) {
        const dependencies = (r.result?.source_dependencies || []).map(path => fileProof(path));
        ledger.items[f] = { ok: true, source, artifacts: resultArtifacts(r.result), dependencies,
          resume_supported: r.result?.resume_supported !== false, receipt: r.receipt || null, result: r.result };
      }
    } catch (e) { r = { ...r, ok: false, error: e.message }; }
    if (manifest) {
      const artifacts = r?.result?.exported?.artifacts || r?.result?.artifact?.members || (r?.result?.artifact ? [r.result.artifact] : []);
      const protectedPaths = [...artifacts.map(a => a.path), ...(r?.result?.source_dependencies || []), r?.receipt].filter(Boolean);
      if (protectedPaths.some(path => resolve(path) === resolve(manifest))) throw new Error('manifest must not overwrite an output artifact, acceptance receipt or input dependency');
    }
    if (!r?.ok) ledger.items[f] = { ok: false, source, error: r?.error || 'unknown failure' };
    items.push({ file: f, ok: r?.ok === true, ...(r?.ok ? { result: r.result } : { error: r?.error || 'unknown failure', ...(r?.result ? { result: r.result } : {}) }) });
    if (manifest) writeJsonAtomic(manifest, ledger);
  }
  const failed = items.filter(i => !i.ok).length;
  if (manifest) writeJsonAtomic(manifest, ledger);
  return { ok: failed === 0, result: { total: items.length, succeeded: items.length - failed, failed,
    skipped: items.filter(i => i.skipped).length, ...(manifest ? { manifest: resolve(manifest) } : {}), items } };
}

function batchOptions(flags, command, params) {
  if ((flags.resume || flags.manifest) && !flags.batch) throw new Error('--manifest and --resume require --batch');
  if (flags.manifest === true) throw new Error('missing value for --manifest');
  if (flags.manifest && !String(flags.manifest).toLowerCase().endsWith('.json')) throw new Error('--manifest must name a .json file separate from exported assets');
  if (flags.manifest && flags.accept && resolve(flags.manifest) === resolve(flags.accept)) throw new Error('manifest must not overwrite the acceptance spec');
  const bin = blenderBin(flags);
  const version = spawnSync(bin, ['--version'], { encoding: 'utf8', timeout: 10000, stdio: ['ignore', 'pipe', 'pipe'] });
  if (version.error || version.status !== 0) throw new Error('cannot identify Blender for batch manifest');
  const { resume, manifest, ...workFlags } = flags;
  const signature = createHash('sha256').update(stableJson({ command, params, flags: workFlags,
    binary: bin, version: version.stdout, tool_version: PKG.version,
    acceptance: flags.accept ? fileProof(flags.accept) : null })).digest('hex');
  // Resume and ledger path affect orchestration, not the work to be reused.
  return { manifest: flags.manifest ? resolve(flags.manifest) : null, resume: !!flags.resume, signature };
}

function stableJson(value) {
  const normalize = x => Array.isArray(x) ? x.map(normalize)
    : x && typeof x === 'object' ? Object.fromEntries(Object.keys(x).sort().map(k => [k, normalize(x[k])])) : x;
  return JSON.stringify(normalize(value));
}

const stemOf = (f) => basename(f).replace(/\.[^.]+$/, '');

const commands = {};

commands.receipt = (args, ctx) => {
  try {
    const { positional } = fdn.parseArgs(args, COMMON_FLAGS);
    if (positional[0] !== 'verify' || !positional[1] || positional.length !== 2) throw new Error('usage: blender-cli receipt verify <receipt.json>');
    const r = checkReceipt(positional[1]); show(r, ctx); if (!r.ok) process.exitCode = 1;
  } catch (e) { show({ ok: false, error: e.message }, ctx); process.exitCode = 1; }
};

commands.assets = async (args, ctx) => {
  try {
    const { flags, positional } = fdn.parseArgs(args, ['type', 'category', 'limit', ...COMMON_FLAGS]);
    if (positional[0] !== 'search') throw new Error('usage: blender-cli assets search [query] [--type hdri|texture|model] [--category name] [--limit N] [--refresh]');
    if (flags.type !== undefined && !Object.values(PH_TYPE_NAMES).includes(flags.type)) throw new Error('asset type must be hdri|texture|model');
    const limit = flags.limit === undefined ? 20 : Number(flags.limit);
    if (!Number.isInteger(limit) || limit < 1 || limit > 200) throw new Error('--limit must be an integer between 1 and 200');
    const root = process.env.BLENDER_CLI_CACHE_DIR || join(homedir(), '.cache', 'blender-cli');
    const cache = join(root, `polyhaven-index-${flags.type || 'all'}.json`);
    let data, cached = false;
    if (!flags.refresh && existsSync(cache)) {
      try { const c = JSON.parse(readFileSync(cache, 'utf8')); if (Date.now() - c.fetched_at < 3600000) { data = c.data; cached = true; } } catch {}
    }
    if (!data) {
      const providerType = { hdri: 'hdris', texture: 'textures', model: 'models' }[flags.type];
      data = await fetchJson(`https://api.polyhaven.com/assets${providerType ? '?type=' + providerType : ''}`);
      if (!data || typeof data !== 'object' || Array.isArray(data)) throw new Error('invalid Poly Haven catalogue response');
      writeJsonAtomic(cache, { fetched_at: Date.now(), data });
    }
    const query = positional.slice(1).join(' ').trim().toLowerCase();
    const category = flags.category === undefined ? null : String(flags.category).toLowerCase();
    const rows = [];
    for (const [id, asset] of Object.entries(data)) {
      const kind = PH_TYPE_NAMES[asset.type];
      if (flags.type && kind !== flags.type) continue;
      const categories = Array.isArray(asset.categories) ? asset.categories : [];
      if (category && !categories.some(c => c.toLowerCase() === category)) continue;
      const texts = [id, asset.name || '', ...categories, ...(asset.tags || [])].map(t => String(t).toLowerCase());
      const score = !query || texts.includes(query) ? 0 : texts.some(t => t.startsWith(query)) ? 1 : texts.some(t => t.includes(query)) ? 2 : null;
      if (score === null) continue;
      rows.push({ score, id, name: asset.name || id, type: kind, categories, source_url: `https://polyhaven.com/a/${id}`, license: 'CC0', import: `polyhaven:${id}` });
    }
    rows.sort((a, b) => a.score - b.score || a.id.localeCompare(b.id));
    show({ ok: true, provider: 'Poly Haven', credit: 'Powered by Poly Haven', provider_url: 'https://polyhaven.com', query, cached, matched: rows.length, returned: Math.min(rows.length, limit),
      assets: rows.slice(0, limit).map(({ score, ...asset }) => asset) }, ctx);
  } catch (e) { show({ ok: false, error: e.message }, ctx); process.exitCode = 1; }
};

const DIFF_BODY = `import hashlib, struct
from mathutils import Vector
sc = bpy.context.scene
if PARAMS.get("frame") is not None: sc.frame_set(PARAMS["frame"])
bpy.context.view_layer.update()
deps = bpy.context.evaluated_depsgraph_get()
objects = []
for o in sorted(sc.objects, key=lambda o: o.name):
    row = {"name": o.name, "type": o.type, "parent": o.parent.name if o.parent else None,
        "collections": sorted(c.name for c in o.users_collection),
        "matrix_world": [[round(float(v), 7) for v in r] for r in o.matrix_world],
        "hidden_render": o.hide_render,
        "materials": [s.material.name if s.material else None for s in o.material_slots],
        "modifiers": [{"name": m.name, "type": m.type, "render": m.show_render} for m in o.modifiers]}
    if o.type in ("MESH", "CURVE", "SURFACE", "FONT", "META"):
        evaluated = o.evaluated_get(deps)
        mesh = evaluated.to_mesh()
        try:
            if mesh:
                h = hashlib.sha256()
                for v in mesh.vertices: h.update(struct.pack("<3d", *[round(float(x), 6) for x in v.co]))
                for poly in mesh.polygons:
                    h.update(struct.pack("<II", len(poly.vertices), poly.material_index))
                    for index in poly.vertices: h.update(struct.pack("<I", index))
                row["geometry"] = {"vertices": len(mesh.vertices), "faces": len(mesh.polygons), "sha256": h.hexdigest()}
                coords = [evaluated.matrix_world @ Vector(v) for v in evaluated.bound_box]
                row["bounds"] = [[round(min(v[i] for v in coords), 7) for i in range(3)],
                                 [round(max(v[i] for v in coords), 7) for i in range(3)]]
        finally: evaluated.to_mesh_clear()
    objects.append(row)
result["comparison"] = {"objects": objects, "scene": {"engine": sc.render.engine,
    "resolution": [sc.render.resolution_x, sc.render.resolution_y, sc.render.resolution_percentage],
    "frame_range": [sc.frame_start, sc.frame_end], "frame": sc.frame_current, "fps": sc.render.fps,
    "camera": sc.camera.name if sc.camera else None}}
`;

commands.diff = (args, ctx) => {
  try {
    const { flags, positional } = fdn.parseArgs(args, ['frame', 'tolerance', ...COMMON_FLAGS]);
    if (positional.length !== 2) throw new Error('usage: blender-cli diff <before.blend> <after.blend> [--frame N] [--tolerance N] [--fail-on-change]');
    const tolerance = flags.tolerance === undefined ? 1e-6 : Number(flags.tolerance);
    if (!Number.isFinite(tolerance) || tolerance < 0 || flags.tolerance === true) throw new Error('--tolerance must be a non-negative number');
    if (flags.frame !== undefined && (flags.frame === true || !Number.isInteger(Number(flags.frame)))) throw new Error('--frame must be an integer');
    const snapshots = positional.map(blend => {
      const r = runBlender(DIFF_BODY, { blend, flags, params: { frame: flags.frame === undefined ? null : Number(flags.frame) } });
      if (!r.ok) throw new Error(`${blend}: ${r.error}`);
      return r.result.comparison;
    });
    const equal = (a, b) => typeof a === 'number' && typeof b === 'number' ? Math.abs(a - b) <= tolerance
      : a && b && typeof a === 'object' && typeof b === 'object' ?
        Object.keys(a).length === Object.keys(b).length && Object.keys(a).every(k => Object.hasOwn(b, k) && equal(a[k], b[k]))
        : a === b;
    const [before, after] = snapshots;
    const a = new Map(before.objects.map(o => [o.name, o])), b = new Map(after.objects.map(o => [o.name, o]));
    const added = [...b.keys()].filter(n => !a.has(n)), removed = [...a.keys()].filter(n => !b.has(n));
    const changed = [];
    for (const [name, object] of b) if (a.has(name)) {
      const fields = [...new Set([...Object.keys(a.get(name)), ...Object.keys(object)])].filter(k => !equal(a.get(name)[k], object[k]));
      if (fields.length) changed.push({ name, fields });
    }
    const scene = Object.keys(before.scene).filter(k => !equal(before.scene[k], after.scene[k]));
    const different = added.length + removed.length + changed.length + scene.length > 0;
    const ok = !(flags['fail-on-change'] && different);
    show({ ok, changed: different, before: resolve(positional[0]), after: resolve(positional[1]), tolerance,
      objects: { added, removed, changed }, scene, ...(ok ? {} : { error: 'scene comparison found changes' }) }, ctx);
    if (!ok) process.exitCode = 1;
  } catch (e) { show({ ok: false, error: e.message }, ctx); process.exitCode = 1; }
};

// `blender-cli doctor` — find Blender, confirm headless bpy works, report
// version verdict, importers/exporters, video support, and GPU render devices.
//
// TESTED_VERSIONS is the matrix the release was actually run against, not a
// guess. Anything outside it reports `untested`, never `supported`: claiming
// support for a major nobody exercised is how a tool tells a user everything is
// fine right up until an operator it never called moved.
const TESTED_VERSIONS = ['4.3', '5.2'];
const MIN_VERSION = [3, 0];

function supportVerdict(v) {
  if (!v) return null;
  const mm = `${v[0]}.${v[1]}`;
  if (TESTED_VERSIONS.includes(mm)) return `tested (${mm})`;
  if (v[0] < MIN_VERSION[0]) return `unsupported (needs Blender ${MIN_VERSION.join('.')}+)`;
  const newest = TESTED_VERSIONS[TESTED_VERSIONS.length - 1];
  const drift = v[0] > Number(newest.split('.')[0]) ? 'newer major than anything in the matrix' : 'not in the tested matrix';
  return `untested (${drift}; tested on ${TESTED_VERSIONS.join(', ')}) — engines and import/export operators are resolved at runtime, so it may well work; please report breakage at https://github.com/renezander030/blender-cli/issues`;
}
commands.doctor = async (args, ctx) => {
